  "lines": [
    {
      "id": "R01",
      "verse": 541,
      "text": "по законꙋ брачити сѧ може"
    },
    {
      "id": "R02",
      "verse": 542,
      "text": "и имити нескверное ложе."
    },
    {
      "id": "R03",
      "verse": 543,
      "text": "али тꙋ что сѧ ѿ неи чꙋе:"
    },
    {
      "id": "R04",
      "verse": 544,
      "text": "бракъ презире, дѣвствꙋ почитꙋе!"
    },
    {
      "id": "R05",
      "verse": 545,
      "text": "то сѧ еще ни сѧ догодило,"
    },
    {
      "id": "R06",
      "verse": 546,
      "text": "ни сѧ дагди во свѣтѣ видило,"
    },
    {
      "id": "R07",
      "verse": 547,
      "text": "да ѡсьтане [sic!] безбрачнаѧ дѣва"
    },
    {
      "id": "R08",
      "verse": 548,
      "text": "ѿ плема и рода царева."
    },
    {
      "id": "R09",
      "verse": 549,
      "text": "та едина перва ѡбѣща сѧ,"
    },
    {
      "id": "R10",
      "verse": 550,
      "text": "дѣвство Бг҃ꙋ дати завища сѧ;"
    },
    {
      "id": "R11",
      "verse": 551,
      "text": "сама себе Бг҃ови ѡбрꙋчи,"
    },
    {
      "id": "R12",
      "verse": 552,
      "text": "царица сѧ Вѣшнѣмъ препорꙋчи."
    },
    {
      "id": "R13",
      "verse": 553,
      "text": "возлюбила оу дѣвствꙋ ѡстати,"
    },
    {
      "id": "R14",
      "verse": 554,
      "text": "паче неже сꙋпрꙋжествꙋ дати."
    },
    {
      "id": "R15",
      "verse": 555,
      "text": "что да творимъ со Пречистою"
    },
    {
      "id": "R16",
      "verse": 556,
      "text": "Дѣвꙋ, со дщерою Їѡакимовою?"
    },
    {
      "id": "R17",
      "verse": 557,
      "text": "прописана лѣта исполнила,"
    },
    {
      "id": "R18",
      "verse": 558,
      "text": "сꙋпрꙋжеско житие достигла;"
    },
    {
      "id": "R19",
      "verse": 559,
      "text": "что ей треба, все е наꙋчила,"
    },
    {
      "id": "R20",
      "verse": 560,
      "text": "совершенꙋ кнѣгꙋ*) изꙋчила,"
    },
    {
      "id": "R21",
      "verse": 561,
      "text": "евреиское с҃то писанїи,"
    },
    {
      "id": "R22",
      "verse": 562,
      "text": "ктомꙋ еще и рꙋкодѣлїе."
    },
    {
      "id": "R23",
      "verse": 563,
      "text": "не можетъ ктомꙋ при церкви ѡстати."
    },
    {
      "id": "R24",
      "verse": 564,
      "text": "непорочнꙋ комꙋ хочемо дати?"
    },
    {
      "id": "R25",
      "verse": 565,
      "text": "родителѧ давно оужъ преставилъ,"
    },
    {
      "id": "R26",
      "verse": 566,
      "text": "двѣ сироти тꙋ ѡставилъ"
    },
    {
      "id": "R27",
      "verse": 567,
      "text": "Бг҃ꙋ: Аннꙋ ѡсемъдесятъ лѣтнꙋ"
    },
    {
      "id": "R28",
      "verse": 568,
      "text": "и Марію дѣвꙋ благолѣпнꙋ“."
    },
    {
      "id": "R29",
      "verse": 569,
      "text": "Архиерей ѿверзъ оуста своѧ"
    },
    {
      "id": "R30",
      "verse": 570,
      "text": "сказовати видѣнїѧ тоѧ,"
    },
    {
      "id": "R31",
      "verse": 571,
      "text": "како вѣдѣ бж҃їѧ ангела,"
    },
    {
      "id": "R32",
      "verse": 572,
      "text": "нарочито великаго Гаврила,"
    },
    {
      "id": "R33",
      "verse": 573,
      "text": "которїи во храмъ прихожаше,"
    },
    {
      "id": "R34",
      "verse": 574,
      "text": "небеснꙋю пищꙋ приношаше,"
    },
    {
      "id": "R35",
      "verse": 575,
      "text": "присно Дѣвѣ**) тꙋю подаваше,"
    },
    {
      "id": "R36",
      "verse": 576,
      "text": "часто с нею собесидоваше."
    },
    {
      "id": "R37",
      "verse": 577,
      "text": "зѣло чꙋдно животъ провождаше,"
    }
