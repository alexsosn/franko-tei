                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "preface-2-line-06",
            "text": "не есхатольоґічні апокріфи про смерть, розставанє душі з тїлом",
            "bbox_xywh": [
              102,
              1357,
              976,
              33
