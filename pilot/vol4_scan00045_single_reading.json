                "language": "uk",
                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "preface-2-line-07",
            "text": "і т. и. Автор очевидно не має в своїй уяві нїякого з тих образів,",
            "bbox_xywh": [
              102,
              1391,
              976,
