                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "preface-2-line-05",
            "text": "приклад того, як мало впливу на старочеських поетів мали влас-",
            "bbox_xywh": [
              102,
              1322,
              976,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-45-image-20261126",
                "start": 0,
