                "language": "uk",
                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "preface-2-line-04",
            "text": "мій збірцї (стор. 92—107) та в пізнїйших чеських співанниках. Се",
            "bbox_xywh": [
              102,
              1287,
              976,
              33
