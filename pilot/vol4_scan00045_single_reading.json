                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "preface-2-line-03",
            "text": "Інтересна особливо пісня „O smrtedlnosti“, захована в тій са-",
            "bbox_xywh": [
              102,
              1252,
              976,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
