                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "preface-2-line-02",
            "text": "і оглядає небо і процес сотвореня сьвіта (Patera op. cit. 1—57).",
            "bbox_xywh": [
              102,
              1217,
              976,
