                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "preface-2-line-10",
            "text": "кож на Заходї (спілка смерти з Сатаною і демонами, образи по-",
            "bbox_xywh": [
              102,
              1496,
              976,
              33
