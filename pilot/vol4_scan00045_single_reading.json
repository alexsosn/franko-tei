                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "preface-2-line-09",
            "text": "суд і були зачерпнені зі старих теольоґічних концепцій, відомих та-",
            "bbox_xywh": [
              102,
              1461,
              976,
