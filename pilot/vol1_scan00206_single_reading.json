                "text_version": "gpt62-i206-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-potiphar-l008",
            "text": "красенъ есть. Измалтене же рѣкоша: проданъ⁶— есть намъ.⁶)",
            "bbox_xywh": [
              101,
              1097,
              921,
              31
