                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i206-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-potiphar-l003",
            "text": "рад[и] злато много прїяти ѿ етера¹) велмож[и]. идущимъ ж[е]",
            "bbox_xywh": [
              101,
              919,
              921,
              31
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
