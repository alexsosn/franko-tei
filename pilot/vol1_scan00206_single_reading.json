                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i206-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-potiphar-l004",
            "text": "имъ сквозе град срете и Петефрии, властелинъ²— цря египеть-",
            "bbox_xywh": [
              101,
              954,
              921,
              31
