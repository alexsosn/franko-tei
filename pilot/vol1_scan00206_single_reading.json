                "text_version": "gpt62-i206-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-potiphar-l007",
            "text": "ѡбраза, иже⁵) вы носите, зане вси вы Измалтене есте, а сеи пре-",
            "bbox_xywh": [
              101,
              1061,
              921,
              31
            ],
            "geometry_estimated": true,
            "language_spans": [
