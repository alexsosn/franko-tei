                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i206-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-potiphar-l006",
            "text": "рцете ми, купци, ѿкуду есть юноша сей? не носит бо того⁴)",
            "bbox_xywh": [
              101,
              1025,
              921,
              31
