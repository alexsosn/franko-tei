                "uncertain": true
              }
            ],
            "bbox_xywh": [
              64,
              1038,
              948,
              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "salome-line-02",
            "text": "стигла нас, претожъ прошꙋ тя, бѣгай оу҆ мѣсто и҆ приведи ми",
            "language_spans": [
              {
                "text_version": "gpt62-ii-201-atlas-20261128",
                "start": 0,
                "end": 59,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ],
            "bbox_xywh": [
              64,
              1074,
              948,
              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "salome-line-03",
            "text": "бабꙋ“. тоє гди ся стало, в том часѣ агглъ҃ бож[ій] про[г]лагола",
            "language_spans": [
              {
                "text_version": "gpt62-ii-201-atlas-20261128",
                "start": 0,
                "end": 63,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ],
            "bbox_xywh": [
              64,
              1110,
              948,
              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "salome-line-04",
            "text": "єдиной нѣкоторой бабѣ виѳлеємской, ко[то]рой и҆мя было Сало-",
            "language_spans": [
              {
                "text_version": "gpt62-ii-201-atlas-20261128",
                "start": 0,
                "end": 60,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ],
            "bbox_xywh": [
              64,
              1146,
              948,
              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "salome-line-05",
            "text": "мѣя: „скоро — мовит — Саломиє иди оу҆ поле, и҆ найдеш там",
            "language_spans": [
              {
                "text_version": "gpt62-ii-201-atlas-20261128",
                "start": 0,
                "end": 57,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ],
            "bbox_xywh": [
              64,
              1182,
              948,
              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "salome-line-06",
            "text": "дв҃цꙋ, породила Ѡроча и҆ ти возпрїими его и҆ бꙋдеши благосло-",
            "language_spans": [
              {
                "text_version": "gpt62-ii-201-atlas-20261128",
                "start": 0,
                "end": 61,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ],
            "bbox_xywh": [
              64,
              1218,
              948,
              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "salome-line-07",
            "text": "венна на вѣки“. Слишавши то баба Саломия голос из неба скоро",
            "language_spans": [
              {
                "text_version": "gpt62-ii-201-atlas-20261128",
                "start": 0,
                "end": 60,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ],
            "bbox_xywh": [
              64,
              1254,
              948,
              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "salome-line-08",
            "text": "порвавши ся силою бж҃їєю побѣгла за мѣсто на поле. а коли",
            "language_spans": [
              {
                "text_version": "gpt62-ii-201-atlas-20261128",
                "start": 0,
                "end": 57,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ],
            "bbox_xywh": [
              64,
              1290,
              948,
              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "salome-line-09",
            "text": "Іѡсиф ишол по бабꙋ, мл҃ил собѣ: „Бж҃е всемогꙋщий, и где би",
            "language_spans": [
              {
                "text_version": "gpt62-ii-201-atlas-20261128",
                "start": 0,
                "end": 58,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ],
            "bbox_xywh": [
              64,
              1326,
              948,
              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "salome-line-10",
            "text": "знайти бабꙋ, и҆ як єй маю привести?“ и҆ то ємꙋ помыслившꙋ,",
            "language_spans": [
              {
                "text_version": "gpt62-ii-201-atlas-20261128",
                "start": 0,
                "end": 58,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ],
            "bbox_xywh": [
              64,
              1363,
              948,
              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "salome-line-11",
            "text": "и҆ мало ѡ҆ишов, аж ово стрѣтит на пꙋти бабꙋ. И рече баба: „Ѡ",
            "language_spans": [
              {
                "text_version": "gpt62-ii-201-atlas-20261128",
                "start": 0,
                "end": 60,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ],
            "bbox_xywh": [
              64,
              1399,
              948,
              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "salome-line-12",
            "text": "чл҃овече, ѿкол ти идеш? повѣж ми, где єси слыхал, аби дѣва",
            "language_spans": [
              {
                "text_version": "gpt62-ii-201-atlas-20261128",
                "start": 0,
                "end": 58,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ],
            "bbox_xywh": [
              64,
              1435,
              948,
              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "salome-line-13",
            "text": "дитя оу҆ поли породила? слишах бо голосъ из неба, абым тамо",
            "language_spans": [
              {
                "text_version": "gpt62-ii-201-atlas-20261128",
                "start": 0,
                "end": 59,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ],
            "bbox_xywh": [
              64,
              1471,
              948,
              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "salome-line-14",
            "text": "ишла и҆ послꙋжила той дв҃ци при єи пороженю, и҆ то идꙋ и҆ не",
            "language_spans": [
              {
                "text_version": "gpt62-ii-201-atlas-20261128",
                "start": 0,
                "end": 60,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ],
            "bbox_xywh": [
              64,
              1507,
              948,
              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "salome-line-15",
            "text": "вѣм, где идꙋ“. слишавши то Іѡсифъ почꙋди ся и҆ прослави Бг҃а",
            "language_spans": [
              {
                "text_version": "gpt62-ii-201-atlas-20261128",
                "start": 0,
                "end": 60,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ],
            "bbox_xywh": [
              64,
              1543,
              948,
              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "salome-line-16",
            "text": "и рече: „Слава тобѣ Бж҃е, я҆ко твориши преславная и҆ дивная во",
            "language_spans": [
              {
                "text_version": "gpt62-ii-201-atlas-20261128",
                "start": 0,
                "end": 62,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ],
            "bbox_xywh": [
              64,
              1579,
              948,
              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "salome-line-17",
            "text": "мирѣ!“ и҆ приведе бабꙋ, и҆ тꙋ видѣ Саломѣя благодат бж҃ію",
            "language_spans": [
              {
                "text_version": "gpt62-ii-201-atlas-20261128",
                "start": 0,
