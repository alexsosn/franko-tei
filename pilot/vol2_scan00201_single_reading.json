        "lines": [
          {
            "id": "salome-line-01",
            "text": "Тꙋтъ рече Пречт҃ая ст҃ая: „Ѡ Іѡсифе, бл҃гдать бож[ія] по-",
            "language_spans": [
              {
                "text_version": "gpt62-ii-201-atlas-20261128",
                "start": 0,
                "end": 57,
                "language": "orv",
