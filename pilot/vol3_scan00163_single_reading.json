                "uncertain": true,
                "start": 54,
                "end": 63
              }
            ]
          },
          {
            "id": "body-3-line-09",
            "text": "высоко поднесеный, наиболшей бозтво Хво҃ оутвердил мовачи:",
            "bbox_xywh": [
