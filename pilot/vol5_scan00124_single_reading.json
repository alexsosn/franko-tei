                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00124-20261126"
              }
            ]
          },
          {
            "id": "body-5-line-03",
            "text": "ст҃го связана, влекоуще ж съ ним и доблестеннѣйшꙋю цр҃цꙋ.",
            "bbox_xywh": [
              100,
              1177,
              1016,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 57,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00124-20261126"
              }
            ]
          },
          {
            "id": "body-5-line-04",
            "text": "она ж оусръдно послѣдоющи, въ оумѣ мл҃яще ся, оустнѣ токмо",
            "bbox_xywh": [
              100,
              1218,
              1016,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 58,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00124-20261126"
              }
            ]
          },
          {
            "id": "body-5-line-05",
            "text": "двигоущи и на нб҃о часто възирающи. егда же въ нѣкоем мѣсте",
            "bbox_xywh": [
              100,
              1258,
              1016,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00124-20261126"
              }
            ]
          },
          {
            "id": "body-5-line-06",
            "text": "бысть пренемогающи, сѣсти испросити. ѿраду же давшоу водя-",
            "bbox_xywh": [
              100,
              1299,
              1016,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 58,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00124-20261126"
              }
            ]
          },
          {
            "id": "body-5-line-07",
            "text": "щим ю, приклони ся сѣсти, и главу на колѣну въсклонивши",
            "bbox_xywh": [
              100,
              1340,
              1016,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 55,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00124-20261126"
              }
            ]
          },
          {
            "id": "body-5-line-08",
            "text": "Гв҃и дх҃ъ предаде. мч҃ник же Хс҃въ Геѡргїй прослави Ба҃ о быв-",
            "bbox_xywh": [
              100,
              1380,
              1016,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 62,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00124-20261126"
              }
            ]
          },
          {
            "id": "body-5-line-09",
            "text": "шемъ, и того бл҃годаривъ съ многою идяше радостїю мл҃я ся.",
            "bbox_xywh": [
              100,
              1421,
              1016,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 58,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00124-20261126"
              }
            ]
          },
          {
            "id": "body-5-line-10",
            "text": "и того теченїю съвръшити ся добрѣ. ꙗко приближи ся къ наре-",
            "bbox_xywh": [
              100,
              1461,
              1016,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00124-20261126"
              }
            ]
          },
          {
            "id": "body-5-line-11",
            "text": "ченномоу мѣстоу, и к воиномъ рече: „облегчите ми, братїе, ма-",
            "bbox_xywh": [
              100,
              1502,
              1016,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 61,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00124-20261126"
              }
            ]
          },
          {
            "id": "body-5-line-12",
            "text": "ло“. и подавшим же имъ попꙋщенїе, възрѣв на нб҃о и простеръ",
            "bbox_xywh": [
              100,
              1543,
              1016,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00124-20261126"
              }
            ]
          },
          {
            "id": "body-5-line-13",
            "text": "рꙋцѣ, съ стенанїемъ въздвиг на нб҃о и мл҃яше ся сице: „Бж҃е",
            "bbox_xywh": [
              100,
              1583,
              1016,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00124-20261126"
              }
            ]
          },
          {
            "id": "body-5-line-14",
            "text": "мой превѣчный, к немоу ж прибѣгох азъ ѿ юности моея,",
            "bbox_xywh": [
              100,
              1624,
              1016,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
