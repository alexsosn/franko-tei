        "geometry_estimated": true,
        "lines": [
          {
            "id": "body-4-line-01",
            "text": "Повелѣ своимъ ап҃ломъ ископати землю и сътворити мѣ-",
            "bbox_xywh": [
              120,
              1398,
              978,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
