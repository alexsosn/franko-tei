                "end": 52,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-4-line-02",
            "text": "сто яко жилище. таже томоу бывшоу пришед леже и повелѣ оу-",
            "bbox_xywh": [
              120,
              1433,
              978,
              36
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00149-20261126",
                "start": 0,
                "end": 58,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-4-line-03",
            "text": "чн҃ком си закрывше ѡити, яко же и сътвориша. потомь же з҃.",
            "bbox_xywh": [
              120,
              1469,
              978,
              36
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00149-20261126",
                "start": 0,
                "end": 58,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-4-line-04",
            "text": "дн҃їи пришедше оучн҃ци и хотѣша видѣти, аще есть оумерлъ,",
            "bbox_xywh": [
              120,
              1505,
              978,
              36
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00149-20261126",
                "start": 0,
                "end": 57,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-4-line-05",
            "text": "да искоутаютъ, но ѡкрывше и не ѡбрѣт'ше ничесоже, ап҃ловоу",
            "bbox_xywh": [
              120,
              1541,
              978,
              36
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00149-20261126",
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "start": 0,
                "end": 58
              }
            ]
          },
          {
            "id": "body-4-line-06",
            "text": "тѣлѹ престѹпльшю, аможе повелѣлъ любивыи его Хс҃, якоже",
            "bbox_xywh": [
              120,
              1577,
              978,
              36
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00149-20261126",
                "start": 0,
                "end": 55,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-4-line-07",
            "text": "Мѡисїи преже.",
            "bbox_xywh": [
              120,
              1613,
              978,
