            "bbox_xywh": [
              120,
              1170,
              978,
              36
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00149-20261126",
                "start": 0,
                "end": 62,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-3-line-11",
            "text": "ся каменїю бездш҃нѹ, но творцю Бгоу҃. и нн҃ѣ милъ ти ся дѣю",
            "bbox_xywh": [
              120,
              1206,
              978,
              36
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00149-20261126",
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-3-line-12",
            "text": "и молю тя вел'ми: въстави сего оумръшаго, да си познаеть",
            "bbox_xywh": [
              120,
              1242,
              978,
              36
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00149-20261126",
                "start": 0,
                "end": 56,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-3-line-13",
            "text": "своего творца“. видѣв же Іѡанъ вѣрна соуща жерца ѕѣло, непо-",
            "bbox_xywh": [
              120,
              1278,
              978,
              36
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00149-20261126",
                "start": 0,
                "end": 60,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-3-line-14",
            "text": "жадно моли Бга҃, и въстави скоро оусопшаго; живъ же по семъ",
            "bbox_xywh": [
              120,
              1314,
              978,
              36
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00149-20261126",
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-3-line-15",
            "text": "и състарев ся добрѣ. в сь дн҃ь держимыи хрст҃їаны праздникъ.",
            "bbox_xywh": [
              120,
              1350,
              978,
              37
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00149-20261126",
                "start": 0,
                "end": 60,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          }
        ]
