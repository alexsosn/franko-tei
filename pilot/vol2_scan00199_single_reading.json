            "geometry_estimated": true
          },
          {
            "id": "nativity-v-line-09",
            "text": "дѣвичества єй, ѡ҆брѣте ся дв҃а имꙋщи во чревѣ своем ѿ Дх҃а",
            "language_spans": [
              {
