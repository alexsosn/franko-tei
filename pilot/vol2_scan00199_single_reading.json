              32
            ],
            "geometry_estimated": true
          },
          {
            "id": "nativity-v-line-10",
            "text": "ст҃ого, по реченномꙋ єй ѿ аггла҃ посланца божого, коли єй рек:",
            "language_spans": [
              {
                "text_version": "gpt62-ii-199-atlas-20261128",
                "start": 0,
                "end": 62,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ],
            "bbox_xywh": [
              79,
              1013,
              940,
              32
            ],
            "geometry_estimated": true
          },
          {
            "id": "nativity-v-line-11",
            "text": "„Мріє҃ господже, дочко домꙋ Іѡакимова, радꙋй ся! а то Дх҃ъ",
            "language_spans": [
              {
                "text_version": "gpt62-ii-199-atlas-20261128",
                "start": 0,
                "end": 58,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
