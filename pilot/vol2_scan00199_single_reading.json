          },
          {
            "id": "nativity-v-line-13",
            "text": "чревѣ своем и҆ народиш сн҃а и҆ нарекꙋт и҆мя ємꙋ Іс҃, ѡ҆ которого",
            "language_spans": [
              {
                "text_version": "gpt62-ii-199-atlas-20261128",
                "start": 0,
                "end": 64,
                "language": "orv",
                "script": "Cyrl",
