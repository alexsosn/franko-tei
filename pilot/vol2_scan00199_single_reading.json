              32
            ],
            "geometry_estimated": true
          },
          {
            "id": "nativity-v-line-12",
            "text": "ст҃ый найде на тя и҆ сила Вишняго ѡ҆сѣнит тя. прїимеши во",
            "language_spans": [
              {
                "text_version": "gpt62-ii-199-atlas-20261128",
                "start": 0,
                "end": 57,
                "language": "orv",
                "script": "Cyrl",
