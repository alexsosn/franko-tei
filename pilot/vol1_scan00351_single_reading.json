    "uncertainty_notes": [
      {
        "line_id": "psalter-authorship-second-end-l001",
        "reading": "положи за Іильтаны и таа бяше вина сп҃снїа Іильска, того ради",
        "reason": "Historical type: exact titla, breathings, diacritics, apostrophes and glyphs provisional."
      },
      {
        "line_id": "psalter-authorship-second-end-l002",
        "reading": "книгы тыя ся нарекоша; тако ж[е] по Дв҃дѣ, яко то[и] єс[ть]",
        "reason": "Historical type: exact titla, breathings, diacritics, apostrophes and glyphs provisional."
      },
      {
        "line_id": "psalter-authorship-second-end-l003",
        "reading": "вина славословїю бж҃їю быв'шемоу, того дѣла книги нарекоша",
        "reason": "Historical type: exact titla, breathings, diacritics, apostrophes and glyphs provisional."
      },
      {
        "line_id": "psalter-authorship-second-end-l004",
        "reading": "с[я] „псал'мы Дв҃двы“.",
        "reason": "Historical type: exact titla, breathings, diacritics, apostrophes and glyphs provisional."
      },
      {
        "line_id": "psalter-order-l001",
        "reading": "Зазор'но бо єс[ть] и се, яко не по радоу стоят псал'мы сїи,",
        "reason": "Historical type: exact titla, breathings, diacritics, apostrophes and glyphs provisional."
      },
      {
        "line_id": "psalter-order-l002",
        "reading": "[не] яко написани были к҃. лѣт[ы], но измѣнили с[я] соут ѿ много",
        "reason": "Historical type: exact titla, breathings, diacritics, apostrophes and glyphs provisional."
      },
      {
        "line_id": "psalter-order-l003",
        "reading": "лѣт, яко ж[е] въ книгах псаломских пишет. Жидове наченше",
        "reason": "Historical type: exact titla, breathings, diacritics, apostrophes and glyphs provisional."
      },
      {
        "line_id": "psalter-order-l004",
        "reading": "служ[и]ти идолом забыиша ѡбычаєвъ ѡц҃евъ своихъ, Моусеѡвоу",
        "reason": "Historical type: exact titla, breathings, diacritics, apostrophes and glyphs provisional."
      },
      {
        "line_id": "psalter-order-l005",
        "reading": "законоу, ни памяти имѣти своихъ ѡбычаєвъ, пр҃орокы своя на-",
        "reason": "Historical type: exact titla, breathings, diacritics, apostrophes and glyphs provisional."
      },
      {
        "line_id": "psalter-order-l006",
        "reading": "ч[а]ша избивати ѡбличаємии ѿ них. Єгда ж[е] и пръвое полонив'ше",
        "reason": "Historical type: exact titla, breathings, diacritics, apostrophes and glyphs provisional."
      },
      {
        "line_id": "psalter-order-l007",
        "reading": "Асоурїи ведоша, да нѣс[ть] се див'но, яко въ таковѣ бѣдѣ",
        "reason": "Historical type: exact titla, breathings, diacritics, apostrophes and glyphs provisional."
      },
      {
        "line_id": "psalter-order-l008",
        "reading": "соуще погоубили соут и забыли соут на многа лѣта писанїа псал'-",
        "reason": "Historical type: exact titla, breathings, diacritics, apostrophes and glyphs provisional."
      },
      {
        "line_id": "psalter-order-l009",
        "reading": "мовъ. Потом же Єздра пр҃орокъ потощав' ся нача искати своєго",
        "reason": "Historical type: exact titla, breathings, diacritics, apostrophes and glyphs provisional."
      },
      {
        "line_id": "psalter-order-l010",
        "reading": "в'сего; тогда и псал'мы събра. не въ скорѣ ѡбрѣт[е] в'сѣхъ, но",
        "reason": "Historical type: exact titla, breathings, diacritics, apostrophes and glyphs provisional."
      },
      {
        "line_id": "psalter-order-l011",
        "reading": "на многа лѣта, да єго ж[е] пръвѣе налѣзе, то ж[е] пръвѣе на-",
        "reason": "Historical type: exact titla, breathings, diacritics, apostrophes and glyphs provisional."
      },
      {
        "line_id": "psalter-order-l012",
        "reading": "писаше. тѣм же Дв҃двы псал'мы не по радоу соут писаны в'сѣ:",
        "reason": "Historical type: exact titla, breathings, diacritics, apostrophes and glyphs provisional."
      },
      {
        "line_id": "psalter-order-l013",
        "reading": "иж[е] соут по них сн҃ы Кореѡвъ и Асаѳовъ и прочихъ, тако ж[е]",
        "reason": "Historical type: exact titla, breathings, diacritics, apostrophes and glyphs provisional."
      },
      {
        "line_id": "psalter-order-l014",
        "reading": "паки Дв҃двы ѡбрѣтают ся посрѣд их иным смѣшени, а не лежат",
        "reason": "Historical type: exact titla, breathings, diacritics, apostrophes and glyphs provisional."
      },
      {
        "line_id": "psalter-order-l015",
        "reading": "по радоу яко ж[е] соут сотворени, но лежат яко кождо є[сть]",
        "reason": "Historical type: exact titla, breathings, diacritics, apostrophes and glyphs provisional."
      },
      {
        "line_id": "psalter-order-l016",
        "reading": "пръвѣе налѣзенъ. тѣмъ єс[ть] ключило, да послѣднїи ѡбрѣтени",
        "reason": "Historical type: exact titla, breathings, diacritics, apostrophes and glyphs provisional."
      },
      {
        "line_id": "psalter-order-l017",
        "reading": "соут пръвѣе, а по ина лѣта по слꙋсѣ [в ркп. хибно: по слѣсѣ]",
        "reason": "Historical type: exact titla, breathings, diacritics, apostrophes and glyphs provisional."
      },
      {
        "line_id": "psalter-order-l018",
        "reading": "ѡбрѣтени соут пръвѣе, да поставлени соут на конци.",
        "reason": "Historical type: exact titla, breathings, diacritics, apostrophes and glyphs provisional."
      },
      {
        "line_id": "david-nathan-prelude-l001",
        "reading": "Дв҃дъ ж[е] родом бяше незлобивъ, да и Саоуловы дѣти",
        "reason": "Historical type: exact titla, breathings, diacritics, apostrophes and glyphs provisional."
      },
      {
        "line_id": "david-nathan-prelude-l002",
        "reading": "нача мл҃овати. стояше ж[е] жена в' полатахъ, оувидѣвъ женоу",
        "reason": "Historical type: exact titla, breathings, diacritics, apostrophes and glyphs provisional."
      },
      {
        "line_id": "david-nathan-prelude-l003",
        "reading": "Оурїиноу мыющи с[я] и прїиде ко неи, и Оурїю на полкꙋ оубиша,",
