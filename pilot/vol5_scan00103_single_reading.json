                "text_version": "gpt62-v5s00103-20261126"
              }
            ]
          },
          {
            "id": "body-2-line-05",
            "text": "никъ июдеескъ. абїе повелѣ и привести из домоу вдовича. и ве-",
            "bbox_xywh": [
              120,
              1440,
              970,
              32
