                "text_version": "gpt62-v5s00103-20261126"
              }
            ]
          },
          {
            "id": "body-2-line-04",
            "text": "ся? Ѿвѣщаша же емꙋ: он бо затворенъ ест со вдовицею, и застꙋп-",
            "bbox_xywh": [
              120,
              1404,
              970,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
