            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 61,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00103-20261126"
              }
            ]
          },
          {
            "id": "body-1-line-31",
            "text": "и рече мч҃никъ Хс҃въ: то ти годнѣ ест жено, но навди отроча се",
            "bbox_xywh": [
              119,
              1227,
