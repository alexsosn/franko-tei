                "start": 0,
                "end": 58,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00103-20261126"
              }
            ]
          },
          {
            "id": "body-1-line-29",
            "text": "тище. чюдо тогда же видѣвши жена рече: ст҃ыи Геѡргіи, дабы",
            "bbox_xywh": [
              119,
              1156,
              970,
              32
