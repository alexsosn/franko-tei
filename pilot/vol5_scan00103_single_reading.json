                "uncertain": false,
                "text_version": "gpt62-v5s00103-20261126"
              }
            ]
          },
          {
            "id": "body-2-line-07",
            "text": "и не могыи мч҃никъ Хс҃въ прїимати ранъ, и возрѣвъ на нб҃о рече:",
            "bbox_xywh": [
              120,
              1513,
