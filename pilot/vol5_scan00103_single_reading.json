                "uncertain": false,
                "text_version": "gpt62-v5s00103-20261126"
              }
            ]
          },
          {
            "id": "body-2-line-08",
            "text": "Ги҃ сп҃се Хе҃! абїе придаст свои дх҃ъ на смр҃ть. и повелѣ цр҃ь Да-",
            "bbox_xywh": [
              120,
