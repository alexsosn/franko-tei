            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 58,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00103-20261126"
              }
            ]
          },
          {
            "id": "body-1-line-30",
            "text": "еще прослышало, помоли ся и сотвори мл҃твꙋ, и нозѣ простерло.",
            "bbox_xywh": [
              119,
              1191,
              970,
