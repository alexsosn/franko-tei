                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00103-20261126"
              }
            ]
          },
          {
            "id": "body-2-line-09",
            "text": "діань тѣло его нести на горꙋ высокꙋ. понесоша тѣло его мч҃ника",
            "bbox_xywh": [
