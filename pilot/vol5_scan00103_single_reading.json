                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00103-20261126"
              }
            ]
          },
          {
            "id": "body-1-line-28",
            "text": "чавъ мл҃твꙋ рече аминь, и дꙋнꙋ на очи дѣтицю, и прозрѣ дѣ-",
            "bbox_xywh": [
              119,
              1120,
