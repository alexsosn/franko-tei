        "lines": [
          {
            "id": "body-6-line-01",
            "text": "Потом цр҃ь повелѣ ст҃аго їзвести на горꙋ высокꙋю и звяза-",
            "bbox_xywh": [
              110,
              1419,
              961,
              30
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
