                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00139-20261127"
              }
            ]
          },
          {
            "id": "body-6-line-02",
            "text": "ти и спꙋстити з гори, аби ся розбилъ, але не вредило ст҃омꙋ",
            "bbox_xywh": [
              110,
              1459,
              961,
              30
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 59,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00139-20261127"
              }
            ]
          },
          {
            "id": "body-6-line-03",
            "text": "ничтоже. В той часъ разярил ся цр҃ь велми ї повелѣ привязати",
            "bbox_xywh": [
              110,
              1500,
              961,
              30
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 60,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00139-20261127"
              }
            ]
          },
          {
            "id": "body-6-line-04",
            "text": "до столпа раменем, аби ся не моглъ порꙋшити. и казалъ роженъ",
            "bbox_xywh": [
              110,
              1541,
              961,
              30
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 60,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00139-20261127"
              }
