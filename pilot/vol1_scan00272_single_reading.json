                "text_version": "gpt62-i272-first-image-20261125"
              }
            ]
          },
          {
            "id": "zebulun-opening-l008",
            "text": "веє невед[е]нія, еже сътворихъ на Ѡсифѣ, ꙗко известихъ си²) бра-",
            "bbox_xywh": [
              114,
              1554,
              947,
              34
