                "text_version": "gpt62-i272-first-image-20261125"
              }
            ]
          },
          {
            "id": "zebulun-opening-l002",
            "text": "и ді҃. лѣт живот[а] его, по двою лѣт[у] смр҃ти Іѡсифовѣ, и реч[е]",
            "bbox_xywh": [
              114,
              1342,
              947,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 65,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i272-first-image-20261125"
              }
            ]
          },
          {
            "id": "zebulun-opening-l003",
            "text": "к нимъ: „послоуш[а]ите мене, сн҃ве Завлони, внушите словеса ѡц҃а",
            "bbox_xywh": [
              114,
              1377,
              947,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 64,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i272-first-image-20261125"
              }
            ]
          },
          {
            "id": "zebulun-opening-l004",
            "text": "вашего. азъ есмь Завлонъ, даръ бл҃гъ родителем своимъ. в ро-",
            "bbox_xywh": [
              114,
              1413,
              947,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 60,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i272-first-image-20261125"
              }
            ]
          },
          {
            "id": "zebulun-opening-l005",
            "text": "женіе мое разбогате ѡц҃ь мои зѣло ѿ паствины¹) и волъми, егда",
            "bbox_xywh": [
              114,
              1448,
              947,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 61,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i272-first-image-20261125"
              }
            ]
          },
          {
            "id": "zebulun-opening-l006",
            "text": "в пестрых жезлѣхъ прія часть. не вѣдѣ, аще съгрѣшихъ коли,",
            "bbox_xywh": [
              114,
              1484,
              947,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 58,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i272-first-image-20261125"
              }
            ]
          },
          {
            "id": "zebulun-opening-l007",
            "text": "развеє в помышленіи, ни помню, ꙗко безак[о]ніе сътворихъ, раз-",
            "bbox_xywh": [
              114,
              1519,
              947,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 62,
                "language": "cu",
