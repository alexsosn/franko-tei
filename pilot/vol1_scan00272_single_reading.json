        "geometry_estimated": true,
        "lines": [
          {
            "id": "zebulun-opening-l001",
            "text": "Вписаніе словесъ Завлони, еже предасть сн҃мъ своим въ р҃.",
            "bbox_xywh": [
              114,
              1306,
              947,
              34
