                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00129-20261126"
              }
            ]
          },
          {
            "id": "body-6-line-14",
            "text": "мꙋ и пречыстой Мт҃ре его. Ѡ Бж҃е нб҃сный, коли мя той смок",
            "bbox_xywh": [
              83,
              1498,
