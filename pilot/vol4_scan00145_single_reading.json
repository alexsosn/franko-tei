                "start": 0,
                "end": 61,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "liturgy-line-31",
            "text": "моє, єжє за вы за многы“, тогда исполнит сѧ храм разꙋма, тогда",
            "bbox_xywh": [
              114,
              1231,
              942,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-145-image-20261127",
                "start": 0,
                "end": 62,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "liturgy-line-32",
            "text": "ст҃їи аг҃гли рассмотрив’ше таиноу гл҃ют: „Амин“, тогда тѣло при-",
            "bbox_xywh": [
              114,
              1267,
              942,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-145-image-20261127",
                "start": 0,
                "end": 64,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "liturgy-line-33",
            "text": "ложит сѧ до половины въ хлѣб. Поп възгл҃єт: „Пїите ѿ нея",
            "bbox_xywh": [
              114,
              1302,
              942,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-145-image-20261127",
                "start": 0,
