                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "liturgy-line-34",
            "text": "въси, се єсть кровь моя новаго завѣта“, [тог]да вси исплънят сѧ",
            "bbox_xywh": [
              114,
              1337,
              942,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-145-image-20261127",
                "start": 0,
                "end": 63,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "liturgy-line-35",
            "text": "разꙋма, да разꙋмѣют, яко велика и страшна сила [Гня]. гл҃а",
            "bbox_xywh": [
              114,
              1372,
              942,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-145-image-20261127",
                "start": 0,
                "end": 58,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "liturgy-line-36",
            "text": "поп: „Сотвори влдко ѹбо сеи хлѣб чⷭтное тѣло Га҃ нш҃его Іс҃ Ха҃,",
            "bbox_xywh": [
              114,
              1408,
              942,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
