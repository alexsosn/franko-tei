                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "liturgy-line-30",
            "text": "дет Гь҃ съ высоты. гл҃єт поп: „Прїимѣте и ядите, се єсть тѣло",
            "bbox_xywh": [
              114,
              1196,
              942,
              32
