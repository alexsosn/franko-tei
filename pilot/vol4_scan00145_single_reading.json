                "start": 0,
                "end": 56,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "liturgy-line-29",
            "text": "аг҃глъ поюща: „ст҃ ст҃ ст҃ Гь҃“. тогда ѡкрыют сѧ з҃. нб҃съ и прїи-",
            "bbox_xywh": [
              114,
              1161,
              942,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-145-image-20261127",
                "start": 0,
