                "text_version": "gpt62-iv-145-image-20261127",
                "start": 0,
                "end": 64,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "liturgy-line-37",
            "text": "а ижє въ чаши сеи, сама чⷭтная кров Ха҃ твоєго. приложи ѡбоє",
            "bbox_xywh": [
              114,
              1443,
              942,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-145-image-20261127",
                "start": 0,
                "end": 60,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "liturgy-line-38",
            "text": "Дх҃ом твоим ст҃ым“, тогда аг҃гли възємлют грѣхы ѿ чл҃вѣк [и] ѡгнем",
            "bbox_xywh": [
