                "start": 25,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "liturgy-line-28",
            "text": "закрывающа лица своя ѿ неприкосновен’ныя славы. множство",
            "bbox_xywh": [
              114,
              1126,
              942,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
