              36
            ],
            "geometry_estimated": true
          },
          {
            "id": "john-life-line-12",
            "text": "чинꙋ, абы ся за нас грѣшных причинив до Га҃ Ба҃, абы то и҆ нас",
            "language_spans": [
              {
                "text_version": "gpt62-ii-190-atlas-20261128",
