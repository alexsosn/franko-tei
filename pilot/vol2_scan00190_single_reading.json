            "bbox_xywh": [
              105,
              1292,
              1033,
              36
            ],
            "geometry_estimated": true
          },
          {
            "id": "john-life-line-07",
            "text": "на свѣтѣ над Іѡана Кр҃стителя. Але тыж и҆ в' цр҃ствѣ нбс҃номъ",
            "language_spans": [
              {
                "text_version": "gpt62-ii-190-atlas-20261128",
                "start": 0,
                "end": 61,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ],
            "bbox_xywh": [
              105,
              1332,
              1033,
              36
            ],
            "geometry_estimated": true
          },
          {
            "id": "john-life-line-08",
            "text": "не єст болшого над Іѡана ст҃ого: стоитъ зав'ше близко при Хꙋ҃",
            "language_spans": [
              {
                "text_version": "gpt62-ii-190-atlas-20261128",
                "start": 0,
                "end": 61,
                "language": "orv",
                "script": "Cyrl",
