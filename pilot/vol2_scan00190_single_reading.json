            ],
            "bbox_xywh": [
              105,
              1252,
              1033,
              36
            ],
            "geometry_estimated": true
          },
          {
            "id": "john-life-line-06",
            "text": "приятелем бж҃їимъ. Не народил бо ся меже невѣстами болшїй",
            "language_spans": [
              {
                "text_version": "gpt62-ii-190-atlas-20261128",
                "start": 0,
                "end": 57,
                "language": "orv",
                "script": "Cyrl",
