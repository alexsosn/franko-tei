              36
            ],
            "geometry_estimated": true
          },
          {
            "id": "john-life-line-13",
            "text": "грѣшных Бг҃ъ приняв до цр҃ства своего нбс҃ного со ст҃ыми жыти",
            "language_spans": [
              {
                "text_version": "gpt62-ii-190-atlas-20261128",
                "start": 0,
