            "bbox_xywh": [
              105,
              1451,
              1033,
              36
            ],
            "geometry_estimated": true
          },
          {
            "id": "john-life-line-11",
            "text": "и҆ в' поч'тивости его мѣти, мл҃ти ся ємꙋ, просити его ѡ҆ при-",
            "language_spans": [
              {
                "text_version": "gpt62-ii-190-atlas-20261128",
                "start": 0,
                "end": 61,
                "language": "orv",
                "script": "Cyrl",
