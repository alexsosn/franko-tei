              105,
              1411,
              1033,
              36
            ],
            "geometry_estimated": true
          },
          {
            "id": "john-life-line-10",
            "text": "дество его чс҃тное, которое то ст҃о, братіє, повиннисмо ст҃ити",
            "language_spans": [
              {
                "text_version": "gpt62-ii-190-atlas-20261128",
                "start": 0,
                "end": 62,
                "language": "orv",
                "script": "Cyrl",
