            "bbox_xywh": [
              105,
              1371,
              1033,
              36
            ],
            "geometry_estimated": true
          },
          {
            "id": "john-life-line-09",
            "text": "оу҆ маестатꙋ Бж҃ого. Которого то єст дн҃сь ст҃о нарочито, рож-",
            "language_spans": [
              {
                "text_version": "gpt62-ii-190-atlas-20261128",
                "start": 0,
                "end": 62,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
