              105,
              1213,
              1033,
              36
            ],
            "geometry_estimated": true
          },
          {
            "id": "john-life-line-05",
            "text": "Сподобил ся ѿ Ха҃ бл҃годати: кр҃стив Ха҃ во Іѡр'дани, зостав",
            "language_spans": [
              {
                "text_version": "gpt62-ii-190-atlas-20261128",
                "start": 0,
                "end": 60,
                "language": "orv",
                "script": "Cyrl",
