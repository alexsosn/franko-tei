    "uncertainty_notes": [
      {
        "line_id": "job-wife-end-l001",
        "reading": "стойным бл҃годат[ь] свою“. Тоє рек'ши оусталъ ѿ гноя, помолил",
        "reason": "Historical type: titla, breathings, diacritics, apostrophes and exact glyphs provisional."
      },
      {
        "line_id": "job-wife-end-l002",
        "reading": "ся Гу҃ Бу҃, и ѡпало ѡколо Їѡва струпъ яко ѿ дерева кора, и стало",
        "reason": "Historical type: titla, breathings, diacritics, apostrophes and exact glyphs provisional."
      },
      {
        "line_id": "job-wife-end-l003",
        "reading": "тѣло его красное яко малой дитины. И бл҃годарив Їѡвъ ст҃ый",
        "reason": "Historical type: titla, breathings, diacritics, apostrophes and exact glyphs provisional."
      },
      {
        "line_id": "job-wife-end-l004",
        "reading": "Га҃ Ба҃, и ѡступил ѿ Їѡва діаволъ посрамленъ, як' то ѡ Їѡвѣ",
        "reason": "Historical type: titla, breathings, diacritics, apostrophes and exact glyphs provisional."
      },
      {
        "line_id": "job-wife-end-l005",
        "reading": "пише ст҃омъ оу Бовлей [sic!] оу книгах Исходних в главѣ чоты-",
        "reason": "Historical type: titla, breathings, diacritics, apostrophes and exact glyphs provisional."
      },
      {
        "line_id": "job-wife-end-l006",
        "reading": "рыдесят второй. Бл҃ви Гь҃ послѣдняя Їѡву: єще ему давъ Гд҃ь",
        "reason": "Historical type: titla, breathings, diacritics, apostrophes and exact glyphs provisional."
      },
      {
        "line_id": "job-wife-end-l007",
        "reading": "бол'ше нѣжъ пер'ше. Потом было ѡвець чотырнайцяць [sic!]",
        "reason": "Historical type: titla, breathings, diacritics, apostrophes and exact glyphs provisional."
      },
      {
        "line_id": "job-wife-end-l008",
        "reading": "тисячій, вер'блюдовъ ѕ҃. тисячій, ѡсловъ стадных тисяча. И дал",
        "reason": "Historical type: titla, breathings, diacritics, apostrophes and exact glyphs provisional."
      },
      {
        "line_id": "job-wife-end-l009",
        "reading": "был Бг҃ъ знову Їѡвови сн҃овъ сѣмъ а дѣвокъ тры знову: пер'-",
        "reason": "Historical type: titla, breathings, diacritics, apostrophes and exact glyphs provisional."
      },
      {
        "line_id": "job-wife-end-l010",
        "reading": "шой нарек имя Дн҃ь, а другой было имя Касия, а третой нарек",
        "reason": "Historical type: titla, breathings, diacritics, apostrophes and exact glyphs provisional."
      },
      {
        "line_id": "job-wife-end-l011",
        "reading": "имя Амал'фегоръ. И не было под всею поднб҃сною нѣгде краснѣй-",
        "reason": "Historical type: titla, breathings, diacritics, apostrophes and exact glyphs provisional."
      },
      {
        "line_id": "job-wife-end-l012",
        "reading": "шихъ дѣвок над Їѡвови дѣв'ки. И по той карности жылъ Їѡвъ",
        "reason": "Historical type: titla, breathings, diacritics, apostrophes and exact glyphs provisional."
      },
      {
        "line_id": "job-wife-end-l013",
        "reading": "лѣтъ рѳ҃. а в'сѣхъ лѣтъ его см҃и. И дождавъ видѣти сн҃ы",
        "reason": "Historical type: titla, breathings, diacritics, apostrophes and exact glyphs provisional."
      },
      {
        "line_id": "job-wife-end-l014",
        "reading": "сн҃овъ своихъ аж до четвер'того поколѣня. И потом преставил",
        "reason": "Historical type: titla, breathings, diacritics, apostrophes and exact glyphs provisional."
      },
      {
        "line_id": "job-wife-end-l015",
        "reading": "ся и чс҃но погребенъ бысть.",
        "reason": "Historical type: titla, breathings, diacritics, apostrophes and exact glyphs provisional."
      },
      {
        "line_id": "job-genealogy-l001",
        "reading": "Пишет' же ся, иж знову Їѡвъ оустав ис тыми, которіє",
        "reason": "Historical type: titla, breathings, diacritics, apostrophes and exact glyphs provisional."
      },
      {
        "line_id": "job-genealogy-l002",
        "reading": "оустали по воскресеніи Хс҃вомъ; сіє оубо протолковано оу книгах",
        "reason": "Historical type: titla, breathings, diacritics, apostrophes and exact glyphs provisional."
      },
      {
        "line_id": "job-genealogy-l003",
        "reading": "сырійских. Жыл Їѡвъ оу зем'ли Ав'сидійской на границах Іду-",
        "reason": "Historical type: titla, breathings, diacritics, apostrophes and exact glyphs provisional."
      },
      {
        "line_id": "job-genealogy-l004",
        "reading": "мейских и Аравіях. Перед тымъ пер'ше имя его было Їовавъ,",
        "reason": "Historical type: titla, breathings, diacritics, apostrophes and exact glyphs provisional."
      },
      {
        "line_id": "job-genealogy-l005",
        "reading": "жона же за Їѡвом была Арав'лян'ка а имя ей было Ревека. Мавъ",
        "reason": "Historical type: titla, breathings, diacritics, apostrophes and exact glyphs provisional."
      },
      {
        "line_id": "job-genealogy-l006",
        "reading": "сн҃а, которому было имя Єнонъ, а ѡц҃ъ былъ Їѡву Зарефъ,",
        "reason": "Historical type: titla, breathings, diacritics, apostrophes and exact glyphs provisional."
      },
      {
        "line_id": "job-genealogy-l007",
        "reading": "а мт҃и Їѡвова имя ей было Вороса. Їѡвъ был ѿ Ієсафовых сн҃овъ",
        "reason": "Historical type: titla, breathings, diacritics, apostrophes and exact glyphs provisional."
      },
      {
        "line_id": "job-genealogy-l008",
        "reading": "сн҃ъ; пишет бо быти ему пятому ѿ Ав'раама. Бо Ієсавъ бывъ",
        "reason": "Historical type: titla, breathings, diacritics, apostrophes and exact glyphs provisional."
      },
      {
        "line_id": "job-genealogy-l009",
        "reading": "сн҃ъ Іакововъ а ѡц҃ъ их Ісаакъ сн҃ъ бывъ Авраамовъ. И так",
        "reason": "Historical type: titla, breathings, diacritics, apostrophes and exact glyphs provisional."
      },
      {
        "line_id": "job-genealogy-l010",
        "reading": "Їѡвъ бывъ сн҃ъ Ієсавовых сн҃овъ, правнукъ Іакововъ а в'нукъ Ієса-",
        "reason": "Historical type: titla, breathings, diacritics, apostrophes and exact glyphs provisional."
      },
