    "uncertainty_notes": [
      {
        "line_id": "elisha-children-l001",
        "reading": "был лысый, голова ему была лысая, голая. Оувидѣв'ши Єлисея",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "elisha-children-l002",
        "reading": "дѣти бѣгли за ним корячи его и крычали говорячи: „Лысый!",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "elisha-children-l003",
        "reading": "Плѣшивый! Гологоловый! Плѣшивый!“ Бѣгли за Єлисеем за",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "elisha-children-l004",
        "reading": "мѣсто корячи его и за ризы [сѣ]паючи. Потом не тер'пячи Єлисей",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "elisha-children-l005",
        "reading": "далей тым дѣтем пустым помолилъ ся Бгу҃ и рекъ: „Дай то",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "elisha-children-l006",
        "reading": "Бж҃е нбс҃ный, абы то вас медвѣдь пороздыравъ оушит'ких за",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "elisha-children-l007",
        "reading": "вашу такую збыт'очную пустоту!“ И в' том часѣ гдес ся оузяла",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "elisha-children-l008",
        "reading": "медведица зо двома дѣт'ми и там пороздирала медведица",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "elisha-children-l009",
        "reading": "тых своеволных пустошных дѣтей оушит'ких сорок и пятеро,",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "elisha-children-l010",
        "reading": "и пошла оу лѣсъ. А Єлисей пошолъ оу пущу и в'селил ся во єдину",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "elisha-children-l011",
        "reading": "печару и там пребывал на мл҃твах ст҃ых.",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "elisha-miracles-l001",
        "reading": "Той же Єлисей жонѣ єдиной на имя Соман'танины во-",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "elisha-miracles-l002",
        "reading": "скресыл сн҃а єѣ оумерлаго. Той же Єлисей ст҃ый Єрыхонскіє воды",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "elisha-miracles-l003",
        "reading": "гор'кіє, сотворывши мл҃тву, оусыпал оу тоты воды соли и стали",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "elisha-miracles-l004",
        "reading": "воды солодкіє и людям пожыточные.",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "elisha-naaman-l001",
        "reading": "Повѣдают книги цр҃ственные четвер'тыи оу главѣ пятой,",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "elisha-naaman-l002",
        "reading": "яко бы той же Єлисей ст҃ый пророкъ бж҃ій єдиного князя Асы-",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "elisha-naaman-l003",
        "reading": "рыйского на имя Неємана очестил [sic!] его ѿ проказы, коли",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "elisha-naaman-l004",
        "reading": "ему росказал был сѣмъ раз погрузити ся оу рѣцѣ Іѡр'дани:",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "elisha-naaman-l005",
        "reading": "и коли ся погрузилъ, зараз ѿ него пропала злая проказа, и в'чи-",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "elisha-naaman-l006",
        "reading": "нило ся тѣло его красное велми, яко ѡрочате молодого, и был",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "elisha-naaman-l007",
        "reading": "здоровъ и красенъ тѣлом. Тѣхъ молитвами Гс҃ди ст҃ых твоихъ",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "elisha-naaman-l008",
        "reading": "ѡбохъ пророковъ Ілій и Єлисея помилуй насъ и сп҃си дша҃ нша҃",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
