                "text_version": "gpt62-v3-s00160-20261126",
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false,
                "start": 0,
                "end": 64
              }
            ]
          },
          {
            "id": "commentary-line-04",
            "text": "чи автор користував ся якимсь писаним (чи друкованим) жерелом,",
            "bbox_xywh": [
              137,
              1387,
              962,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00160-20261126",
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false,
                "start": 0,
                "end": 62
              }
            ]
          },
          {
            "id": "commentary-line-05",
            "text": "де Псевдо Прохорів текст був уже перероблений (друковане жерело",
            "bbox_xywh": [
              137,
              1421,
              962,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00160-20261126",
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false,
                "start": 0,
                "end": 63
              }
            ]
          },
          {
            "id": "commentary-line-06",
            "text": "в такім чи подібнім родї нам зовсім незвісне), чи може списував",
            "bbox_xywh": [
              137,
              1454,
              962,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00160-20261126",
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false,
                "start": 0,
                "end": 63
              }
            ]
          },
          {
            "id": "commentary-line-07",
            "text": "своє „казанє“ з памяти, знав Псевдо-Прохора тілько з наслуху",
            "bbox_xywh": [
              137,
              1488,
              962,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00160-20261126",
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false,
                "start": 0,
                "end": 60
              }
            ]
          },
          {
            "id": "commentary-line-08",
            "text": "і компонував собі своє оповіданє при значній участи власної фантазиї.",
            "bbox_xywh": [
