                "uncertain": false,
                "start": 0,
                "end": 60
              }
            ]
          },
          {
            "id": "commentary-line-02",
            "text": "реповідка Псевдо-Прохора, та з такими переставками епізодів і пе-",
            "bbox_xywh": [
              137,
              1319,
              962,
              34
