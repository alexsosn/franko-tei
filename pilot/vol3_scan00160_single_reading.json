                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "start": 0,
                "end": 55
              }
            ]
          },
          {
            "id": "body-4-line-05",
            "text": "ап҃стола Бг҃ослова и ег҃листа Іѡана, Хе҃ Бе҃ нш҃ъ, помилѹи и сп҃си",
            "bbox_xywh": [
              137,
              1195,
              962,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00160-20261126",
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "start": 0,
                "end": 66
              }
            ]
          },
          {
            "id": "body-4-line-06",
            "text": "дш҃а нш҃а во вѣки. Аминь.",
            "bbox_xywh": [
              137,
              1230,
