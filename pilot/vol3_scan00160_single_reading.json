                "script": "Cyrl",
                "uncertain": false,
                "start": 0,
                "end": 65
              }
            ]
          },
          {
            "id": "commentary-line-03",
            "text": "ремінами в самім їх змістї, що ми не зважуємо ся сказати рішучо,",
            "bbox_xywh": [
              137,
              1353,
              962,
              34
