                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "start": 0,
                "end": 60
              }
            ]
          },
          {
            "id": "body-4-line-04",
            "text": "бывает проща великая и ѡ тои манны кождого рокѹ. Твоего",
            "bbox_xywh": [
              137,
              1161,
              962,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
