                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-2-line-08",
            "text": "писалъ Матѳеи еврейскимъ языкомъ, Марко римским, Лука",
            "bbox_xywh": [
              138,
              1312,
