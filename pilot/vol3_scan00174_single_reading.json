                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-2-line-05",
            "text": "чего ѡни не доложили, то ѡнъ докончилъ, и где тѣсно рекли, то",
            "bbox_xywh": [
              138,
              1210,
              981,
              34
