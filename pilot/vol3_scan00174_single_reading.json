                "start": 0,
                "end": 61,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-2-line-06",
            "text": "ѡнъ ширѣи и яснѣ показалъ. абовимъ по л҃-ти лѣтѣхъ по воз-",
            "bbox_xywh": [
              138,
              1244,
              981,
              34
