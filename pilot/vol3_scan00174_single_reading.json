                "start": 0,
                "end": 58,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-2-line-07",
            "text": "несенїи Гни҃ принесли емѹ писанїе трехъ ег҃листов': перше бо его",
            "bbox_xywh": [
              138,
              1278,
              981,
