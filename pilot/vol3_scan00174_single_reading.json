                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-2-line-04",
            "text": "трехъ видѣ писанїа и възрадовал' ся велми прочитавши е, и",
            "bbox_xywh": [
              138,
              1176,
              981,
