                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-2-line-03",
            "text": "языкомъ и ѡдалъ Ефескои цр҃кви вѣрным'. и иншихъ ег҃листовъ",
            "bbox_xywh": [
              138,
              1142,
