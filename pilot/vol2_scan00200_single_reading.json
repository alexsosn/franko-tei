            "geometry_estimated": true
          },
          {
            "id": "journey-line-04",
            "text": "дѣлъ Іѡсиф Мрію҃ — ово ся смѣє, ово плаче. И рече Іѡсифъ:",
            "language_spans": [
              {
                "text_version": "gpt62-ii-200-atlas-20261128",
                "start": 0,
                "end": 57,
                "language": "orv",
