            "geometry_estimated": true
          },
          {
            "id": "journey-line-05",
            "text": "„Мріє҃, что се чиниш? виждꙋ тя: єден час смѣєши ся, а дрꙋгий",
            "language_spans": [
              {
                "text_version": "gpt62-ii-200-atlas-20261128",
                "start": 0,
