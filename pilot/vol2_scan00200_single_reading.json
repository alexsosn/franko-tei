            "geometry_estimated": true
          },
          {
            "id": "journey-line-07",
            "text": "„Ѡ Іѡсифе, виждꙋ на свѣтѣ двоє людей: єднии ся смѣют,",
            "language_spans": [
              {
                "text_version": "gpt62-ii-200-atlas-20261128",
                "start": 0,
                "end": 53,
                "language": "orv",
                "script": "Cyrl",
