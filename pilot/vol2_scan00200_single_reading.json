            "geometry_estimated": true
          },
          {
            "id": "census-line-26",
            "text": "смꙋток', а на оу҆трий дн҃ь бꙋдеш ся веселити посполꙋ из небом",
            "language_spans": [
              {
                "text_version": "gpt62-ii-200-atlas-20261128",
