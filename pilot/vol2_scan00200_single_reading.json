            ],
            "bbox_xywh": [
              129,
              1228,
              1010,
              35
            ],
            "geometry_estimated": true
          },
          {
            "id": "census-line-25",
            "text": "закрито ѡ҆чам людским, але то не на велики час. тепер ти маєш",
            "language_spans": [
              {
                "text_version": "gpt62-ii-200-atlas-20261128",
                "start": 0,
                "end": 61,
                "language": "orv",
                "script": "Cyrl",
