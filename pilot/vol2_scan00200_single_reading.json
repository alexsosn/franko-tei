            "text": "и҆ з землею и҆ со агглами҃ нбс҃ними“. потом ся Іѡсифъ ѡ҆бꙋдил",
            "language_spans": [
              {
                "text_version": "gpt62-ii-200-atlas-20261128",
                "start": 0,
