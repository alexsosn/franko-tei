                "end": 64,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "sectionX-l003",
            "text": "ріянти зведені в отсьому томі. Їх не богато; богатих рукописних",
            "bbox_xywh": [
              99,
              1443,
              1030,
              28
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-single-20261125-v1s00056",
                "start": 0,
                "end": 63,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "sectionX-l004",
            "text": "збірок, таких як у Росії, у нас нема; переважна часть рукописів,",
            "bbox_xywh": [
              99,
              1477,
              1030,
              28
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-single-20261125-v1s00056",
                "start": 0,
                "end": 64,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "sectionX-l005",
            "text": "по яким зладжено отсю збірку — приватна власність моя або дру-",
            "bbox_xywh": [
              99,
              1511,
              1030,
              28
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
