        "lines": [
          {
            "id": "sectionX-l001",
            "text": "X. Рукописи визискані в сьому томі. Лишаєсь нам ще",
            "bbox_xywh": [
              99,
              1375,
              1030,
              28
            ],
            "geometry_estimated": true,
            "language_spans": []
          },
          {
            "id": "sectionX-l002",
            "text": "сказати декілька слів про рукописи, з яких ми брали тексти і ва-",
            "bbox_xywh": [
              99,
              1409,
              1030,
              28
