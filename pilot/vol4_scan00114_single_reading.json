                "text_version": "gpt62-iv-114-image-20261126",
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-35",
            "text": "аще которїй правовѣрнїй хрⷭтїанин ѕ҃. днїй дѣлаєть, а в ст҃ꙋю",
            "bbox_xywh": [
              133,
              1385,
              958,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-114-image-20261126",
                "start": 0,
                "end": 61,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-36",
            "text": "нд҃лю идеⷮ во цр҃ковъ ст҃ꙋю и молиⷮ сѧ за грѣхи своя и слꙋ-",
            "bbox_xywh": [
              133,
              1421,
              958,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-114-image-20261126",
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-37",
            "text": "хаєть писма ст҃аго, єпистолїи сєя, и виполняєть седмъ сакра-",
            "bbox_xywh": [
              133,
              1456,
              958,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-114-image-20261126",
                "start": 0,
                "end": 60,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-38",
            "text": "ментовъ ст҃ыхъ и вистерѣгаєт сѧ грѣховъ своих, то той ѿтри-",
            "bbox_xywh": [
              133,
              1492,
              958,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-114-image-20261126",
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-39",
            "text": "має коронꙋ в царствѣ нбⷭномъ. а которїй чл҃вкъ бꙋдеⷮ грѣшити",
            "bbox_xywh": [
              133,
              1528,
              958,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-114-image-20261126",
                "start": 0,
                "end": 60,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-40",
            "text": "грѣхами смертелними и не покает сѧ грѣховъ своих, то поидеⷮ",
            "bbox_xywh": [
              133,
              1564,
              958,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-114-image-20261126",
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-41",
