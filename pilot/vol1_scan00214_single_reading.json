        "geometry_estimated": true,
        "lines": [
          {
            "id": "joseph-benjamin-lament-l001",
            "text": "[Плач Йосифа, коли побачив Веньямина]. Єгда же видѣ Іѡсиф",
            "bbox_xywh": [
              104,
              1163,
              933,
