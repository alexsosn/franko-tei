                "text_version": "gpt62-i214-first-image-20261125"
              },
              {
                "start": 39,
                "end": 57,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i214-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-benjamin-lament-l002",
            "text": "брата своего Венїамина предстояща съ страхом и трепетом мно-",
            "bbox_xywh": [
              104,
              1198,
              933,
              31
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 60,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i214-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-benjamin-lament-l003",
            "text": "гым, движеся оутроба его зань зѣло, и хотяше ѡхопити и ѡбло-",
            "bbox_xywh": [
              104,
              1233,
              933,
              31
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 60,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i214-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-benjamin-lament-l004",
            "text": "бызати брата своего. „аще въистин'ноу живъ ес[ть] ѡць҃ ваш?",
            "bbox_xywh": [
              104,
              1269,
              933,
              31
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i214-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-benjamin-lament-l005",
            "text": "или помните Іѡсифа?“ не могїи его ѡхопити и въпрашати,",
            "bbox_xywh": [
              104,
              1304,
              933,
              31
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 54,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i214-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-benjamin-lament-l006",
            "text": "въниде въ клѣт свою и въсплакася въ тайнѣ въ тои час, вън'же",
            "bbox_xywh": [
              104,
              1340,
              933,
              31
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 60,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i214-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-benjamin-lament-l007",
            "text": "видѣ брата своего Венїамина. абїє въспомянувъ добраго старца",
            "bbox_xywh": [
              104,
              1375,
              933,
              31
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 60,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i214-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-benjamin-lament-l008",
            "text": "Іякова и гл҃аше съ слезами: „блаженнѣй ѡчи зрящи ст҃го лица",
            "bbox_xywh": [
              104,
              1410,
              933,
              31
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i214-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-benjamin-lament-l009",
            "text": "старости твоея доброты, ѡч҃е! ꙗко ж[е] бо мню, ни все цр҃ство",
            "bbox_xywh": [
              104,
              1446,
              933,
              31
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 61,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i214-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-benjamin-lament-l010",
            "text": "єс[ть] дос[т]оино старости твоея, бг҃олюбезне. и хотѣл бых",
            "bbox_xywh": [
              104,
              1481,
              933,
              31
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 58,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i214-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-benjamin-lament-l011",
            "text": "въпрашати Венїамина, помниши ли мя и любиши ср҃дцем, ꙗкож[е]",
            "bbox_xywh": [
              104,
              1516,
              933,
              31
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 60,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i214-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-benjamin-lament-l012",
            "text": "азъ тебе? того ради нуждих брат[ь]ю свою съ лестїю съвести",
            "bbox_xywh": [
              104,
              1552,
              933,
              31
            ],
