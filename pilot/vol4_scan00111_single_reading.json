          {
            "id": "epistle-line-35",
            "text": "литвы творят за вес мир. Ѡ горе и лютѣ чл҃ком, иж не по правдѣ",
            "bbox_xywh": [
              102,
              1362,
              956,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-111-image-20261126",
                "start": 0,
                "end": 62,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-36",
            "text": "мовят и свѣдчат и творят на невиннаго чл҃ка! Ѡ горе чл҃кꙋ томꙋ",
            "bbox_xywh": [
              102,
              1397,
              956,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-111-image-20261126",
                "start": 0,
                "end": 62,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-37",
            "text": "и сꙋдїям не по правдѣ сꙋдящим или посꙋлъ ємлющим, а сиротам",
            "bbox_xywh": [
              102,
              1432,
              956,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-111-image-20261126",
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-38",
            "text": "и вдовицам не помагающим. Ѡ горе клеветником и грабителем и за-",
            "bbox_xywh": [
              102,
              1467,
              956,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-111-image-20261126",
                "start": 0,
                "end": 63,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-39",
            "text": "видником и злобником. Ѡ горе блꙋдником! Ѡ горе дающим сребро",
            "bbox_xywh": [
              102,
              1503,
              956,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
