                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-40",
            "text": "въ лихвꙋ, а сами ходят во цр҃ков, гордят властїю своєю. да про-",
            "bbox_xywh": [
              102,
              1538,
              956,
              32
