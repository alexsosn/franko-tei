          },
          {
            "id": "body-6-line-06",
            "text": "ца свѣтлость никако же измѣнившоу, цр҃ь почоудивъ ся ко сꙋ-",
            "bbox_xywh": [
              93,
              1509,
              1029,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
