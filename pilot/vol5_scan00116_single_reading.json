                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00116-20261126"
              }
            ]
          },
          {
            "id": "body-6-line-05",
            "text": "кровїю на землю изляти ся. сице же ст҃омоу лютѣ бїемꙋ и ли-",
            "bbox_xywh": [
              93,
              1467,
              1029,
              32
