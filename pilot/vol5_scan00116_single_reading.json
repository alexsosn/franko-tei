                "text_version": "gpt62-v5s00116-20261126"
              }
            ]
          },
          {
            "id": "body-6-line-07",
            "text": "щим тоу гл҃ше: „въ истинноу оубо азъ не моужьствꙋ точїю, но",
            "bbox_xywh": [
              93,
              1551,
              1029,
