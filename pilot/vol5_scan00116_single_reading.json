                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00116-20261126"
              }
            ]
          },
          {
            "id": "body-6-line-04",
            "text": "того бити жилами волоуами нещадно, дондеже плотем его съ",
            "bbox_xywh": [
              93,
              1426,
              1029,
              32
