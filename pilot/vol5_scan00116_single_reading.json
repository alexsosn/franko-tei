                "text_version": "gpt62-v5s00116-20261126"
              }
            ]
          },
          {
            "id": "body-6-line-03",
            "text": "наоучит ся — съ рекши — цр҃емъ не досажати. таже повелѣ",
            "bbox_xywh": [
              93,
              1384,
              1029,
              32
