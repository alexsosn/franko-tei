            "text": "„Аще томоу вѣры не имєте, то ѹжгоу вы ѡгнем и развѣю",
            "bbox_xywh": [
              117,
              1097,
              973,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-102-image-20261126",
                "start": 0,
                "end": 52,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-28",
            "text": "вы яко прах на востоцѣ вѣтрныем. се нн҃ѣ клѧноу сѧ десницею",
            "bbox_xywh": [
              117,
              1133,
              973,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-102-image-20261126",
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-29",
            "text": "моєю, прⷭтолоⷨ моиⷨ высокиⷨ! Аще ли не чтете ни храните ст҃оую",
            "bbox_xywh": [
              117,
              1169,
              973,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-102-image-20261126",
                "start": 0,
                "end": 62,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-30",
            "text": "недлю и празⷣник моиⷯ ст҃ых, поустити имаⷨ на вы змїй дво-",
            "bbox_xywh": [
              117,
              1205,
              973,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-102-image-20261126",
                "start": 0,
                "end": 58,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-31",
            "text": "глав’ный, да изъядаⷮ сес’ца женаⷨ вашиⷨ за престоупленіє ваше",
            "bbox_xywh": [
              117,
              1241,
              973,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-102-image-20261126",
                "start": 0,
                "end": 61,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-32",
            "text": "ст҃ыя ради нд҃лѣ. проклѧт боудет чл҃къ, оуже дѣлаєт каковоє дѣло",
            "bbox_xywh": [
              117,
              1277,
              973,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-102-image-20261126",
                "start": 0,
                "end": 64,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-33",
            "text": "в недлю нж ѡставити дѣла ѿ д҃. чаⷭ въ сꙋботоу до пн҃едел’ка",
            "bbox_xywh": [
              117,
              1313,
              973,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-102-image-20261126",
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-34",
            "text": "свитающаго дн҃е. проклята бꙋди тая рꙋка, ѡже имаєт сѧ како-",
            "bbox_xywh": [
              117,
              1349,
              973,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-102-image-20261126",
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-35",
            "text": "вого дѣла в’ нд҃лю.",
            "bbox_xywh": [
              117,
              1385,
              973,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-102-image-20261126",
                "start": 0,
                "end": 19,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          }
        ]
      },
      {
