            "text": "Іаковꙋ.",
            "bbox_xywh": [
              102,
              885,
              931,
              31
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 7,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i292-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-l024",
            "text": "„Слышите и се, чад[а] моя, еж[е] видѣхъ сонъ, сказаю вамъ",
            "bbox_xywh": [
              102,
              919,
              931,
              31
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 57,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i292-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-l025",
            "text": "и се. ві҃. елени пасашта⁷¹) [sic!] се и г҃. их рассыпаше с[я] въ всю",
            "bbox_xywh": [
              102,
              952,
              931,
              31
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 24,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i292-first-image-20261125"
              },
              {
                "start": 24,
                "end": 27,
                "language": "zxx",
                "script": "Zyyy",
                "uncertain": false,
                "text_version": "gpt62-i292-first-image-20261125"
              },
              {
                "start": 27,
                "end": 28,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i292-first-image-20261125"
              },
              {
                "start": 28,
                "end": 34,
                "language": "la",
                "script": "Latn",
                "uncertain": false,
                "text_version": "gpt62-i292-first-image-20261125"
              },
              {
                "start": 34,
                "end": 68,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i292-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-l026",
            "text": "землю. також[е] и трие видѣх, ꙗко ѿ Іюды роди ся дв҃ца имѣ-",
            "bbox_xywh": [
              102,
              986,
              931,
              31
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i292-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-l027",
            "text": "юще одежею бꙋсиннꙋ, из нея же изыде агнець непорочень, [и] ѡ",
            "bbox_xywh": [
              102,
              1020,
              931,
              31
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 60,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i292-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-l028",
            "text": "левꙋю его ꙗко левъ, и вси зверие ꙋстръмляхꙋ ся нань, и ѡдоле",
            "bbox_xywh": [
              102,
              1053,
              931,
              31
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 60,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i292-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-l029",
            "text": "имъ агнець и погꙋби я в попранїе. и радꙋвах[ꙋ] ся ѡ нѣмь",
            "bbox_xywh": [
              102,
              1087,
              931,
              31
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 56,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i292-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-l030",
            "text": "вси анг҃ли и чл҃вци и вся земля. сих[е] сбꙋдоу́т ся въ врѣмя",
            "bbox_xywh": [
              102,
              1120,
              931,
              31
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 60,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i292-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-l031",
            "text": "свое. радꙋвахꙋ ся ѡ нем в последняя дн҃и. вы же ꙋбо, чада моя,",
            "bbox_xywh": [
              102,
              1154,
              931,
              31
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 62,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i292-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-l032",
            "text": "съхранит[е] заповѣд[и] Гн҃я и чтите Іюдꙋ и Левгию, ꙗко ѿ тою",
            "bbox_xywh": [
              102,
              1188,
              931,
              31
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 60,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i292-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-l033",
            "text": "вамъ взыдетъ агнець Бж҃їй и бл҃гдтію сп҃сая ꙗзыкы вся [и] Ізл҃я,",
            "bbox_xywh": [
              102,
              1221,
              931,
              31
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 64,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i292-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-l034",
            "text": "и цр҃ство бо его цр҃ство вѣчное и еже не прейдет, а мое цр҃ство",
            "bbox_xywh": [
              102,
              1255,
              931,
              31
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 63,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i292-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-l035",
            "text": "скончаеть с[я] в вас, аки овощию хранилища по выиманїю не",
            "bbox_xywh": [
              102,
              1288,
              931,
              31
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 57,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i292-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-l036",
            "text": "ꙗвит ся.*)",
            "bbox_xywh": [
              102,
              1322,
              931,
              31
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 10,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i292-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-l037",
            "text": "„Вѣде, чад[а], ꙗко по кончине моеи Егꙋптен[е] ѡпечалять",
            "bbox_xywh": [
              102,
              1355,
              931,
              31
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 55,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i292-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-l038",
            "text": "васъ, но Б҃ъ сътворит вамъ ѡпꙋщеніе и введет вы въ ѡвещаніе",
            "bbox_xywh": [
              102,
              1389,
              931,
              31
            ],
