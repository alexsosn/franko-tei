                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "lucidarius-line-38",
            "text": "в той земли єⷭ двѣ горѣ, ѡдной имя Арменія, на той горѣ",
            "bbox_xywh": [
              139,
