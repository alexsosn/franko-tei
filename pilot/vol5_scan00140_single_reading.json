            "text": "то, повѣмъ тобѣ: як ти стараєши ся прїяти вѣнецъ ѿ Бг҃а,",
            "bbox_xywh": [
              125,
              1131,
              987,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
