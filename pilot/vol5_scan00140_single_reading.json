                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00140-20261127"
              }
            ]
          },
          {
            "id": "body-3-line-16",
            "text": "то такъ ї ми стараєм ся прїяти дар ѿ ѿца нашего Сатани“.",
            "bbox_xywh": [
              125,
              1170,
