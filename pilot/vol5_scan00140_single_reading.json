        ],
        "geometry_estimated": true,
        "lines": [
          {
            "id": "body-4-line-01",
            "text": "Рече ст҃їй: „Як ти їмя и что твориши хрст҃їаном?“ Опови-",
            "bbox_xywh": [
              128,
              1192,
              985,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 56,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00140-20261127"
              }
            ]
          },
          {
            "id": "body-4-line-02",
            "text": "дѣлъ дїаволъ: „Вельзевꙋлъ їмя моє, борꙋ ся аз со митрополи-",
            "bbox_xywh": [
              128,
              1233,
              985,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 59,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00140-20261127"
              }
            ]
          },
          {
            "id": "body-4-line-03",
            "text": "тами и епископами, арциеб҃скꙋпами ї бїскꙋпами, вмѣтаю их во",
            "bbox_xywh": [
              128,
              1273,
              985,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 59,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00140-20261127"
              }
            ]
          },
          {
            "id": "body-4-line-04",
            "text": "огнь, привождꙋ их, аби грѣшили тяжкими грѣхами, Бг҃а ѿстꙋ-",
            "bbox_xywh": [
              128,
              1313,
              985,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 58,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00140-20261127"
              }
            ]
          },
          {
            "id": "body-4-line-05",
            "text": "пили а нам слꙋжили, а ми за тоє честь и славꙋ прїймєм ѿ ѿца",
            "bbox_xywh": [
              128,
              1353,
              985,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 59,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00140-20261127"
              }
            ]
          },
          {
            "id": "body-4-line-06",
            "text": "нш҃его великого князя Фармадея. И аж творимо во снѣ блꙋд со",
            "bbox_xywh": [
              128,
              1394,
              985,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 59,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00140-20261127"
              }
            ]
          },
          {
            "id": "body-4-line-07",
            "text": "человѣки, аби ся облѣнили на молитви, на всенощная пѣнїя, на",
            "bbox_xywh": [
              128,
              1434,
              985,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 60,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00140-20261127"
              }
            ]
          },
          {
            "id": "body-4-line-08",
            "text": "оутренѣ ї на литоргїи ст҃їє, оучꙋ, аби человѣци блꙋд творили з чꙋ-",
            "bbox_xywh": [
              128,
              1474,
              985,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 66,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00140-20261127"
              }
            ]
          },
          {
            "id": "body-4-line-09",
            "text": "жими женами, а жени аби з чꙋжими человѣками; оучꙋ мꙋжей мꙋ-",
            "bbox_xywh": [
              128,
              1514,
              985,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 59,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00140-20261127"
              }
            ]
          },
          {
            "id": "body-4-line-10",
            "text": "жем честним досаждати, оучꙋ попов, аби во сварах, во гнѣвах",
            "bbox_xywh": [
              128,
              1555,
              985,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 59,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00140-20261127"
              }
            ]
          },
          {
            "id": "body-4-line-11",
            "text": "слꙋжби бж҃їє слꙋжили, во пианствѣ, во блꙋдѣ, аби людей грѣ-",
            "bbox_xywh": [
              128,
              1595,
              985,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 59,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00140-20261127"
              }
            ]
          },
          {
            "id": "body-4-line-12",
            "text": "ховъ не по правдѣ сповѣдали, то я их не по правдѣ на то",
            "bbox_xywh": [
              128,
              1635,
              985,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 55,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00140-20261127"
              }
            ]
          }
        ]
      },
