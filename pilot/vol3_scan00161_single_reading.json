        ],
        "geometry_estimated": true,
        "lines": [
          {
            "id": "body-3-line-01",
            "text": "В' цвѣченю ѡном школы Хвы҃ великїй брал цнотъ всѣх по-",
            "bbox_xywh": [
              131,
              1330,
              972,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00161-20261126",
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "start": 0,
                "end": 54
              }
            ]
          },
          {
            "id": "body-3-line-02",
            "text": "хопъ и был Гд҃ѹ Іс҃ Хви҃ так любимый, же его ег҃лїа якобы над",
            "bbox_xywh": [
              131,
              1363,
              972,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00161-20261126",
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "start": 0,
                "end": 61
              }
            ]
          },
          {
            "id": "body-3-line-03",
            "text": "иншїи емѹ милшого зовет, бо до инших досконалых цнот захо-",
            "bbox_xywh": [
              131,
              1397,
              972,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00161-20261126",
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "start": 0,
                "end": 58
              }
            ]
          },
          {
            "id": "body-3-line-04",
            "text": "вал чистость на тѣлѣ и вѣлъ агг҃льское житїе оу великой собѣ",
            "bbox_xywh": [
              131,
              1430,
              972,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00161-20261126",
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "start": 0,
                "end": 60
              }
            ]
          },
          {
            "id": "body-3-line-05",
            "text": "прїязни Гд҃а и наоучтл҃а своего, поличилъ теж его Хс҃ межи в҃і.",
            "bbox_xywh": [
              131,
              1464,
              972,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00161-20261126",
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "start": 0,
                "end": 63
              }
            ]
          },
          {
            "id": "body-3-line-06",
            "text": "преднѣхъ ап҃лъ и межи ѡныхъ трех до таемницъ своихъ в'зы-",
            "bbox_xywh": [
              131,
              1497,
              972,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00161-20261126",
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "start": 0,
                "end": 57
              }
            ]
          },
          {
            "id": "body-3-line-07",
            "text": "валъ, бо ѡнъ с Петром и из' Іаковом братом своимъ на ѡное",
            "bbox_xywh": [
              131,
              1531,
              972,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00161-20261126",
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "start": 0,
                "end": 57
              }
            ]
          }
        ]
