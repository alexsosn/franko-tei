                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "start": 0,
                "end": 58
              }
            ]
          },
          {
            "id": "body-3-line-20",
            "text": "южъ во гробѣ, тол'ко чревики его. и плакавше порозѹмѣли, яко",
            "bbox_xywh": [
