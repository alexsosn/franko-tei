                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "start": 0,
                "end": 62
              }
            ]
          },
          {
            "id": "body-3-line-18",
            "text": "ижъ без него ѡда дх҃ъ свои в' рѹки Бж҃їи. дрѹгыи же дн҃ь по ра-",
            "bbox_xywh": [
              107,
              1297,
              964,
