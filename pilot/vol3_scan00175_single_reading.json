                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "start": 0,
                "end": 63
              }
            ]
          },
          {
            "id": "body-3-line-19",
            "text": "нѹ с пилностїю пришли оучн҃еве его къ гробѹ и не нашли его",
            "bbox_xywh": [
              107,
              1333,
              964,
              36
