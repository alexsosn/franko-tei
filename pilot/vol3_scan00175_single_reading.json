                "uncertain": true,
                "start": 0,
                "end": 57
              }
            ]
          },
          {
            "id": "body-3-line-15",
            "text": "до мѣста и призови братїю, да негай прїидѹтъ и дадѹт' ми",
            "bbox_xywh": [
