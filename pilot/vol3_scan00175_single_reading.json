                "start": 0,
                "end": 56
              }
            ]
          },
          {
            "id": "body-3-line-16",
            "text": "ѡстатне цѣлованїе, и завтра поранѹ, чадо, прїидете тѹ къ мнѣ“.",
            "bbox_xywh": [
