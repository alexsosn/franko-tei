            "bbox_xywh": [
              127,
              1298,
              1001,
              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "john-birth-intro-line-03",
            "text": "дное засвѣтило и҆ загрѣло. Таким ся способом ст҃ый Іѡанъ на-",
            "language_spans": [
              {
                "text_version": "gpt62-ii-188-atlas-20261128",
                "start": 0,
                "end": 60,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
