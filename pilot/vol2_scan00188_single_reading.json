        "lines": [
          {
            "id": "john-birth-intro-line-01",
            "text": "Оу҆ старости глꙋбокой Єлисаведа ст҃ого Іѡана породила",
            "language_spans": [
              {
                "text_version": "gpt62-ii-188-atlas-20261128",
