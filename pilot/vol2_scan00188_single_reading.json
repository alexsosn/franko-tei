            "geometry_estimated": true
          },
          {
            "id": "john-birth-intro-line-04",
            "text": "родивъ, як пишет ст҃ый єѵ҆глистъ Мар'ко в зачалѣ первом тыми",
            "language_spans": [
              {
                "text_version": "gpt62-ii-188-atlas-20261128",
                "start": 0,
                "end": 60,
