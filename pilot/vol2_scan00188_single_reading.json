            "geometry_estimated": true
          },
          {
            "id": "zachariah-line-07",
            "text": "и҆ увидѣлъ кадячи, ано стоитъ а҆гглъ҃ Гдн҃ь оу престола по пра-",
            "language_spans": [
              {
                "text_version": "gpt62-ii-188-atlas-20261128",
                "start": 0,
                "end": 63,
                "language": "orv",
                "script": "Cyrl",
