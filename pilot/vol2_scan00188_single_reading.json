            "bbox_xywh": [
              127,
              1262,
              1001,
              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "john-birth-intro-line-02",
            "text": "и҆ свѣтилника на свѣт поставила; а за Іѡаном Хс҃ слн҃це праве-",
            "language_spans": [
              {
                "text_version": "gpt62-ii-188-atlas-20261128",
                "start": 0,
                "end": 62,
                "language": "orv",
                "script": "Cyrl",
