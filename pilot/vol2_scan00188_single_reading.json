            "text": "плодꙋ якого, нащадка. Трафило ся томꙋ свщ҃ен'никови Захаріи",
            "language_spans": [
              {
                "text_version": "gpt62-ii-188-atlas-20261128",
                "start": 0,
                "end": 59,
                "language": "orv",
                "script": "Cyrl",
