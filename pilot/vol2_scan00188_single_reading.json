            ],
            "geometry_estimated": true
          },
          {
            "id": "zachariah-line-05",
            "text": "быти оу҆ цр҃кви и҆ литор'гію ст҃ꙋю слꙋжити; и҆ говорывъ молитвы",
            "language_spans": [
              {
                "text_version": "gpt62-ii-188-atlas-20261128",
                "start": 0,
                "end": 63,
