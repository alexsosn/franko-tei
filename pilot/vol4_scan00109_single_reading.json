                "start": 0,
                "end": 58,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-27",
            "text": "пꙋщꙋ на землю, ани росы, што бꙋдете жати? Азъ владꙋ морем",
            "bbox_xywh": [
              101,
              1079,
              960,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-109-image-20261126",
                "start": 0,
                "end": 57,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-28",
            "text": "и рѣками, и помыслих загꙋбити всякаго злаго за ст҃ꙋю нд҃лю.",
            "bbox_xywh": [
              101,
              1114,
              960,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-109-image-20261126",
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-29",
            "text": "Але ѹмолиша ма ст҃їи мои аг҃гли и ст҃ыя мт҃ре моєя слезы,",
            "bbox_xywh": [
              101,
              1149,
              960,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-109-image-20261126",
                "start": 0,
                "end": 57,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-30",
            "text": "и ѹмилосердих сѧ на вас, ѡвратих гнѣвъ свои ѿ вас и дах вам",
            "bbox_xywh": [
              101,
              1184,
              960,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-109-image-20261126",
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-31",
            "text": "законъ кр҃щенїємъ своим, а въ законѣ вашем не ходите, ни єдиноя",
            "bbox_xywh": [
              101,
              1219,
              960,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-109-image-20261126",
                "start": 0,
                "end": 63,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-32",
            "text": "заповѣди моєя не заховаете, воскрⷭнїє Гн҃є не чтите, въ нд҃лю и въ",
            "bbox_xywh": [
              101,
              1254,
              960,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-109-image-20261126",
                "start": 0,
                "end": 66,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-33",
            "text": "средꙋ и паток, и праздников гдⷭких не празднꙋєте ведлꙋг писма",
            "bbox_xywh": [
              101,
              1290,
              960,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-109-image-20261126",
                "start": 0,
                "end": 61,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-34",
            "text": "правдиваго. Не знаете, безꙋмнїи чл҃ци: въ ст҃ꙋю нд҃лю изыидох ко",
            "bbox_xywh": [
              101,
              1325,
              960,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-109-image-20261126",
                "start": 0,
                "end": 64,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-35",
            "text": "Авраамꙋ на землю под дꙋбъ Маврїискїй, и въ ст҃ꙋю нд҃лю явих",
            "bbox_xywh": [
              101,
              1360,
              960,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-109-image-20261126",
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-36",
            "text": "сѧ Моисею въ кꙋпинѣ; въ ст҃ꙋю нд҃лю начаток вашемꙋ спⷭнїю:",
            "bbox_xywh": [
              101,
              1395,
              960,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-109-image-20261126",
                "start": 0,
                "end": 58,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-37",
            "text": "бл҃говѣстил архаг҃глъ радость прⷭтѣй Бц҃и дѣвѣ Мр҃їи въ Наза-",
            "bbox_xywh": [
              101,
              1430,
              960,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-109-image-20261126",
                "start": 0,
                "end": 61,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-38",
            "text": "реѳѣ; въ ст҃ꙋю нд҃лю кр҃щенїє прїяхъ ѿ Іѡанна въ Іѡрдани. а въ",
            "bbox_xywh": [
              101,
              1465,
              960,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-109-image-20261126",
                "start": 0,
                "end": 62,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-39",
            "text": "паток сотворих Адама перваго чл҃ка, и въ паток распяша мене",
            "bbox_xywh": [
              101,
              1501,
              960,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-109-image-20261126",
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-40",
            "text": "жидове на крⷭтѣ, рꙋцѣ и нозѣ мои, и копїємъ ребра моя про-",
            "bbox_xywh": [
              101,
              1536,
              960,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-109-image-20261126",
                "start": 0,
                "end": 58,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-41",
            "text": "бодоша за злыя грѣхи ваша. І єще в нд҃лю воскрⷭсъ ѿ мр҃твых",
            "bbox_xywh": [
              101,
              1571,
              960,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-109-image-20261126",
                "start": 0,
                "end": 59,
