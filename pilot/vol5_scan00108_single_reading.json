        "geometry_estimated": true,
        "lines": [
          {
            "id": "body-2-line-01",
            "text": "Бысть оубо въ времѧ сатаниньскомоу кꙋмирослꙋженїю об-",
            "bbox_xywh": [
              93,
              1423,
              1020,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 53,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00108-20261126"
              }
            ]
          },
          {
            "id": "body-2-line-02",
            "text": "держащꙋ чл҃кы, цр҃ствовати же Деоклитїанꙋ, римьскаго начала па-",
            "bbox_xywh": [
              93,
              1463,
              1020,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 63,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00108-20261126"
              }
            ]
          },
          {
            "id": "body-2-line-03",
            "text": "гꙋбникꙋ нѣкоемоу и звѣрꙋ, бою бывшꙋ на Хс҃во стадо, повинꙋя",
            "bbox_xywh": [
              93,
              1503,
              1020,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00108-20261126"
              }
            ]
          },
          {
            "id": "body-2-line-04",
            "text": "ся ѕѣло прелести поустошных коумиръ. имаше дрꙋга единомыс-",
            "bbox_xywh": [
              93,
              1543,
              1020,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 58,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00108-20261126"
              }
            ]
          },
          {
            "id": "body-2-line-05",
            "text": "ленника, паче же и преходѧща безбожьствомъ Магнента именемъ,",
            "bbox_xywh": [
              93,
              1582,
              1020,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 60,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00108-20261126"
              }
            ]
          },
          {
            "id": "body-2-line-06",
            "text": "иже бѣ вторый въ цр҃ствїи его. и распаляя ся на хрст҃їаны",
            "bbox_xywh": [
              93,
              1622,
              1020,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 57,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00108-20261126"
              }
            ]
          },
          {
            "id": "body-2-line-07",
            "text": "възбеснѣвъ безчестїемъ кꙋмирослꙋженїю съвѣтоваше с нимъ, что",
            "bbox_xywh": [
              93,
              1662,
              1020,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 60,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00108-20261126"
              }
            ]
          },
          {
            "id": "body-2-line-08",
            "text": "бы сътворшема погꙋбити, весма без вѣсти сътворити вѣрꙋ",
            "bbox_xywh": [
              93,
              1702,
              1020,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 54,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00108-20261126"
              }
            ]
          },
          {
            "id": "body-2-line-09",
            "text": "хрст҃їанскꙋю и всѧчески истворити с нꙋждею чтити съ тѣма бо-",
            "bbox_xywh": [
              93,
              1742,
              1020,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 60,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00108-20261126"
              }
            ]
          }
        ]
      }
    ],
    "uncertainty_notes": [
