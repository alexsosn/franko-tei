                "uncertain": false,
                "text_version": "gpt62-i314-first-image-20261125"
              }
            ]
          },
          {
            "id": "tabernacle-l007",
            "text": "Моисей Урина Веселила ѿ племени Июдина товѣ, к сему же дру-",
            "bbox_xywh": [
              104,
              1027,
