                "uncertain": false,
                "text_version": "gpt62-i314-first-image-20261125"
              }
            ]
          },
          {
            "id": "tabernacle-l005",
            "text": "инъ синет, и[н] черьвленицю, дружни [sic!] же вису и брачину",
