                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i314-first-image-20261125"
              }
            ]
          },
          {
            "id": "tabernacle-l004",
            "text": "все дѣло храма сведеніа: инъ злат[о], инъ сребро, инъ медь,",
            "bbox_xywh": [
              104,
              924,
              924,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
