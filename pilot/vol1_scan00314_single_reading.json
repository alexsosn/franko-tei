                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i314-first-image-20261125"
              }
            ]
          },
          {
            "id": "tabernacle-l006",
            "text": "и багряницю приношаху ему. над всеми же дѣлы тѣми пристави",
            "bbox_xywh": [
              104,
              993,
