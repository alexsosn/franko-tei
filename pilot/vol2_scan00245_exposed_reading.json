            "geometry_estimated": true
          },
          {
            "id": "infancy-xviii-line-09",
            "text": "на небесех живет?“ фарисеи же рѣша ко матери: „ты ли єси",
            "language_spans": [
              {
                "text_version": "gpt62-ii-245-parallel-exposed-20261127",
