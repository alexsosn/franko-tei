            "geometry_estimated": true
          },
          {
            "id": "infancy-xviii-line-12",
            "text": "таковыя силы не видѣхомъ ни ѿ когоже“. и воста Іс҃ Хс҃ Гд҃ь",
            "language_spans": [
              {
                "text_version": "gpt62-ii-245-parallel-exposed-20261127",
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
