            "geometry_estimated": true
          },
          {
            "id": "infancy-xviii-line-11",
            "text": "рисее: „бл҃женна ты во женах и бл҃гословенъ плодъ чрева твоего!",
            "language_spans": [
              {
                "text_version": "gpt62-ii-245-parallel-exposed-20261127",
