        "geometry_estimated": true,
        "lines": [
          {
            "id": "naphtali-opening-l001",
            "text": "Вписаніе завѣта Нефталима еже завеща въ врѣмена кон-",
            "bbox_xywh": [
              101,
              1053,
              935,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 52,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i278-first-image-20261125"
              }
            ]
          },
          {
            "id": "naphtali-opening-l002",
            "text": "чины своея в лѣт[о] рл҃. живот[а] своего. съшедшимся сн҃мъ",
            "bbox_xywh": [
              101,
              1089,
              935,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 58,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i278-first-image-20261125"
              }
            ]
          },
          {
            "id": "naphtali-opening-l003",
            "text": "его въ з҃. мц҃ь въ единый [дн҃ь] мца҃ здраву сущу ему, створи",
            "bbox_xywh": [
              101,
              1124,
              935,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 61,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i278-first-image-20261125"
              }
            ]
          },
          {
            "id": "naphtali-opening-l004",
            "text": "веч[е]рю ему¹) и пит[ь]е. и заутра егда възну и реч[е] имъ. ꙗко",
            "bbox_xywh": [
              101,
              1159,
              935,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 63,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i278-first-image-20261125"
              }
            ]
          },
          {
            "id": "naphtali-opening-l005",
            "text": "умираю. и не вѣроваху ему. и бл҃гла Га҃, ꙗко извѣсти имъ, ꙗко",
            "bbox_xywh": [
              101,
              1194,
              935,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 61,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i278-first-image-20261125"
              }
            ]
          },
          {
            "id": "naphtali-opening-l006",
            "text": "в²) сию нощи вечери умрет, нача убо гл҃ти: „послушайте, чада",
            "bbox_xywh": [
              101,
              1230,
              935,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 60,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i278-first-image-20261125"
              }
            ]
          },
          {
            "id": "naphtali-opening-l007",
            "text": "моꙗ, сн҃ве Нефталимови, послушайте сн҃ве³) ѡц҃а вашег[о]. азъ ро-",
            "bbox_xywh": [
              101,
              1265,
              935,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 65,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i278-first-image-20261125"
              }
            ]
          },
          {
            "id": "naphtali-opening-l008",
            "text": "д[и]хся ѿ Баллы, ꙗко хитростію сътвори Рахиль и дасть в себе",
            "bbox_xywh": [
              101,
              1300,
              935,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 60,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i278-first-image-20261125"
              }
            ]
          },
          {
            "id": "naphtali-opening-l009",
            "text": "мѣсто Балу Іякову, и при Рахили роди мя, и того рад[и] наре-",
            "bbox_xywh": [
              101,
              1335,
              935,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 60,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i278-first-image-20261125"
              }
            ]
          },
          {
            "id": "naphtali-opening-l010",
            "text": "ч[е]нъ быхъ Нефталим. и възлюби мя Рахиль, ꙗко пред нею ро-",
            "bbox_xywh": [
              101,
              1371,
              935,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i278-first-image-20261125"
              }
            ]
          },
          {
            "id": "naphtali-opening-l011",
            "text": "дих ся. и еще млад[у] сущу ми лобзаше мя гл҃ющи: абы ми",
            "bbox_xywh": [
              101,
              1406,
              935,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 55,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i278-first-image-20261125"
              }
            ]
          },
          {
            "id": "naphtali-opening-l012",
            "text": "видети брат[і]ю твою ѿ чрева моего ꙗкож[е] и тебѣ. тѣмже по-",
            "bbox_xywh": [
              101,
              1441,
              935,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 60,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i278-first-image-20261125"
              }
            ]
          },
          {
            "id": "naphtali-opening-l013",
            "text": "добенъ ми быс[ть] всемь Іѡсиф по бл҃вленію Рахилину. а мт҃и",
            "bbox_xywh": [
              101,
              1476,
              935,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i278-first-image-20261125"
              }
            ]
          },
          {
            "id": "naphtali-opening-l014",
            "text": "ми есть Бала дщи Руфина, брат[а] Деворина, доилица Ревецина,",
            "bbox_xywh": [
              101,
              1512,
              935,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 60,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i278-first-image-20261125"
              }
            ]
          },
          {
            "id": "naphtali-opening-l015",
            "text": "ꙗже единому дн҃и роди ся[с] Рахил[и]ю. а Руфи¹¹) ѿ рода Авра-",
            "bbox_xywh": [
              101,
