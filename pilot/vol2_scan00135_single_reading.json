            ],
            "geometry_estimated": true
          },
          {
            "id": "source-intro-line-04",
            "text": "Мріи, котрая имала нам породити Хр҃та Месію, Бга҃ мешкаю-",
            "language_spans": [
              {
                "text_version": "gpt62-ii-135-image-harmonized-20261126",
