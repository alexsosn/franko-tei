                "uncertain": true,
                "text_version": "gpt6-i58-native-image-first-20261117"
              }
            ]
          },
          {
            "id": "adam-l007",
            "text": "ди ся теплота дѫша его, и ктомѫ же не мощи пребывати ни съв-",
            "bbox_xywh": [
              95,
              1006,
              1028,
              29
            ],
            "geometry_estimated": true,
            "language_spans": [
