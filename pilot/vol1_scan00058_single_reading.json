                "uncertain": true,
                "text_version": "gpt6-i58-native-image-first-20261117"
              }
            ]
          },
          {
            "id": "adam-l009",
            "text": "и в кожаныѧ ризы. Гл҃ть книги: на томленїа ѡбложенѫ съгрѣ-",
            "bbox_xywh": [
              95,
              1074,
