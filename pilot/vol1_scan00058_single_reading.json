                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt6-i58-native-image-first-20261117"
              }
            ]
          },
          {
            "id": "adam-l008",
            "text": "говат[н] емѫ с горними силами, но ѡблечи ся въ тело се ѧкож[е]",
            "bbox_xywh": [
