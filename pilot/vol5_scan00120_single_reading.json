                "text_version": "gpt62-v5s00120-20261126"
              }
            ]
          },
          {
            "id": "body-8-line-06",
            "text": "невѣжда сый и частїю орачъ, ороущоу емоу, єдиномоу ѿ воловъ",
            "bbox_xywh": [
              96,
              1746,
              1037,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
