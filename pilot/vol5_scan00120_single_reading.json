                "text_version": "gpt62-v5s00120-20261126"
              }
            ]
          },
          {
            "id": "body-7-line-02",
            "text": "бл҃годаря Ба҃ гл҃я: „Слава тобѣ влд҃ко Ги҃, не посрамляяй оупова-",
            "bbox_xywh": [
              96,
              1295,
              1037,
              32
