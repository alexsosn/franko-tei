              }
            ]
          },
          {
            "id": "body-8-line-05",
            "text": "исцѣленїе прїимахоу. въ нихъ же нѣкїй моужъ Гликерїй именемъ,",
            "bbox_xywh": [
              96,
              1703,
              1037,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
