                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00120-20261126"
              }
            ]
          },
          {
            "id": "body-8-line-07",
            "text": "его съ брега спадшоу съкроушити ся и оумрети. ꙗко же ѡ ст҃ем",
            "bbox_xywh": [
              96,
              1788,
              1037,
              32
