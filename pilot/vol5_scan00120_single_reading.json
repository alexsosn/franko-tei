                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00120-20261126"
              }
            ]
          },
          {
            "id": "body-7-line-03",
            "text": "ющихъ на тѧ. бл҃годарꙋ тѧ, ѿ них же въ всѣх поспѣшествовалъ",
            "bbox_xywh": [
              96,
              1338,
              1037,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00120-20261126"
              }
            ]
          },
          {
            "id": "body-7-line-04",
            "text": "ми еси окаянномоу, о них же благодѣтельствꙋеши мя въсегда,",
            "bbox_xywh": [
              96,
              1380,
              1037,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 58,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00120-20261126"
              }
            ]
          },
          {
            "id": "body-7-line-05",
            "text": "ѡ иже заступаеши мое недостоиньство. но сподоби мя, Бж҃е",
            "bbox_xywh": [
              96,
              1422,
              1037,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 56,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00120-20261126"
              }
            ]
          },
          {
            "id": "body-7-line-06",
            "text": "мой, въскорѣ явити ся славѣ твоей, и до конца посрамити",
            "bbox_xywh": [
              96,
              1464,
              1037,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 55,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00120-20261126"
              }
            ]
          },
          {
            "id": "body-7-line-07",
            "text": "дїавола“.",
            "bbox_xywh": [
              96,
              1506,
              1037,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
