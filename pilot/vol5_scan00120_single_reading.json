            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 60,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00120-20261126"
              }
            ]
          },
          {
            "id": "body-8-line-04",
            "text": "ѿ нихъ же и мнози недоугꙋющей и Хс҃ва знаменїа призванїемъ",
            "bbox_xywh": [
              96,
              1661,
              1037,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
