              }
            ]
          },
          {
            "id": "body-8-line-02",
            "text": "роваша съдѣанных ради чоудесъ. приходяща к немоу и стражем",
            "bbox_xywh": [
              96,
              1576,
              1037,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 58,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00120-20261126"
              }
            ]
          },
          {
            "id": "body-8-line-03",
            "text": "мздоу подающе, припадахꙋ пред нимъ и оученїа его послоушахꙋ.",
            "bbox_xywh": [
              96,
              1619,
              1037,
              32
