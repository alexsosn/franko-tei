                "language": "uk",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "lucidarius-line-32",
            "text": "37. Учен. Куда текут тыє рѣки?",
            "bbox_xywh": [
              115,
              1315,
              955,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-81-image-20261126",
                "start": 0,
                "end": 30,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "lucidarius-line-33",
            "text": "Маистер. Ѡцеан течеⷮ скроз Індїю и проходиⷮ єдину гору,",
            "bbox_xywh": [
              115,
              1352,
              955,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-81-image-20261126",
                "start": 0,
                "end": 55,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "lucidarius-line-34",
            "text": "которую зовут Птаис, а ѿтоля течеⷮ скроз муринскую землю",
            "bbox_xywh": [
              115,
              1389,
              955,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-81-image-20261126",
                "start": 0,
                "end": 56,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "lucidarius-line-35",
            "text": "в Червоноє море. Тигръ и Єфрадъ текут скрозъ ѡдну гору, ко-",
            "bbox_xywh": [
              115,
              1425,
              955,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-81-image-20261126",
                "start": 0,
                "end": 59,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "lucidarius-line-36",
            "text": "торую зовут Патрас, а ѿтоля течеⷮ скрозь єдину землю, кото-",
            "bbox_xywh": [
              115,
              1462,
              955,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-81-image-20261126",
                "start": 0,
                "end": 59,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "lucidarius-line-37",
            "text": "рая зовет сѧ Арменія, и тыє воды текут ѡчевисто з раю ѡдною",
            "bbox_xywh": [
              115,
              1498,
              955,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
