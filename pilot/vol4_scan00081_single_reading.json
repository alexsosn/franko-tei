                "start": 0,
                "end": 53,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "lucidarius-line-30",
            "text": "ѡдна студня, с котороє текут рѣки чтыри. Першаа зовет сѧ",
            "bbox_xywh": [
              115,
              1242,
              955,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-81-image-20261126",
                "start": 0,
                "end": 56,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "lucidarius-line-31",
            "text": "Фиссон, вторая Ѡцеанъ, третяя Тигръ, четвертая Єфратъ.",
            "bbox_xywh": [
              115,
              1279,
              955,
              35
