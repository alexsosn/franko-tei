                "start": 0,
                "end": 58
              }
            ]
          },
          {
            "id": "body-2-line-16",
            "text": "в' том оуставил Бг҃ъ войнѹ ср҃дцамъ вашим, абы вѣрили, ижъ",
            "bbox_xywh": [
              143,
              1188,
