                "uncertain": true,
                "start": 0,
                "end": 54
              }
            ]
          },
          {
            "id": "body-3-line-02",
            "text": "гатствамъ свѣта того, на прозбѹ многихъ людей въскр҃сил оумер-",
            "bbox_xywh": [
              143,
              1335,
              960,
              35
