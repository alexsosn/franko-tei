                "uncertain": true,
                "start": 0,
                "end": 59
              }
            ]
          },
          {
            "id": "body-2-line-15",
            "text": "можная е҃ рѹка Гня҃ дати и оучинити ѡбвитыи богатства, але",
            "bbox_xywh": [
              143,
              1153,
