            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00166-20261126",
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "start": 0,
                "end": 56
              }
            ]
          },
          {
            "id": "body-3-line-06",
            "text": "шей и всего веселїа, а позыскали-сте ѡгнь вѣчный в' пеклѣ, бо",
            "bbox_xywh": [
              143,
              1473,
              960,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00166-20261126",
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "start": 0,
                "end": 61
              }
            ]
          },
          {
            "id": "body-3-line-07",
            "text": "вас южъ нѣчого иншого не чекаєтъ, если не оупросите Хва҃ ап҃ла,",
            "bbox_xywh": [
              143,
              1508,
              960,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00166-20261126",
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "start": 0,
                "end": 63
              }
            ]
          },
          {
            "id": "body-3-line-08",
            "text": "абы так яко мене въскр҃силъ в' животѹ, так абы вас теж въс-",
            "bbox_xywh": [
              143,
              1542,
              960,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00166-20261126",
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "start": 0,
