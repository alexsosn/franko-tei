                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "start": 0,
                "end": 57
              }
            ]
          },
          {
            "id": "body-3-line-04",
            "text": "оутратили, а якїи мѹки заслѹжили, повидѣти. а ѡнъ им пови-",
            "bbox_xywh": [
              143,
              1404,
              960,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00166-20261126",
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "start": 0,
                "end": 58
              }
            ]
          },
          {
            "id": "body-3-line-05",
            "text": "дѣлъ, ижъ есте стратили животъ вѣчный полный всѣх роско-",
            "bbox_xywh": [
              143,
              1439,
              960,
              34
