                "script": "Cyrl",
                "uncertain": true,
                "start": 0,
                "end": 62
              }
            ]
          },
          {
            "id": "body-3-line-03",
            "text": "лого и казал емѹ, абы им, якѹю хвалѹ и богатства ѡныи два",
            "bbox_xywh": [
              143,
              1370,
              960,
              34
