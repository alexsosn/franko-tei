                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-2-line-07",
            "text": "ѡнъ яко непрїятел хрст҃їанскїй с' хѹтїю рад тое оучинил. а ѡный",
            "bbox_xywh": [
              138,
              1442,
