          },
          {
            "id": "joseph-brothers-l009",
            "text": "егда брат[і]ꙗ его вменѹхуся ꙗко раби, въздохну Іѡсифъ велми",
            "bbox_xywh": [
              106,
              1120,
              936,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i230-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-brothers-l010",
            "text": "реч[е] имъ: „не тако, ѡц҃и и брат[і]ꙗ! Бж҃ии бо есми азъ и вы вси.",
            "bbox_xywh": [
              106,
              1155,
              936,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 66,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i230-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-brothers-l011",
            "text": "вы възненавидесте мя, но Бъ҃ възлюби мя; вы оубо хотесте мя",
            "bbox_xywh": [
              106,
              1191,
              936,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i230-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-brothers-l012",
            "text": "оубити, но Бъ҃ ѡц҃ь моих съхрани мя. въ ровѣ мя въвръгосте,",
            "bbox_xywh": [
              106,
              1226,
              936,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i230-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-brothers-l013",
            "text": "но Вышнии изведе мя; в работу мя предасте, но всѣх влдка",
            "bbox_xywh": [
              106,
              1261,
              936,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 56,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i230-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-brothers-l014",
            "text": "Г҃ь свободи мя и всему Егупту судъ даят[и] ми сътвори мя.",
            "bbox_xywh": [
              106,
              1296,
              936,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 57,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i230-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-brothers-l015",
            "text": "въ плѣнь бо влѣзохъ, но крѣпкая⁴) рука поможе ми; гладомъ",
            "bbox_xywh": [
              106,
              1331,
              936,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 57,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i230-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-brothers-l016",
            "text": "ѡвятъ бых, и самъ Г҃ь препита мя. единъ оубо бѣхъ в ровѣ,",
            "bbox_xywh": [
              106,
              1366,
              936,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 57,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i230-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-brothers-l017",
            "text": "но Бъ҃ ѡц҃а моег[о] оутѣши мя; в болѣзни бѣхъ, но Бъ҃ посѣти",
            "bbox_xywh": [
              106,
              1401,
              936,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 60,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i230-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-brothers-l018",
            "text": "мя. в темници бѣхъ, но Сп҃сь радость ми сътвори. въ оузе",
            "bbox_xywh": [
              106,
              1437,
              936,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 56,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i230-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-brothers-l019",
            "text": "ѡрѣши мя и въ ѡклеветаніи Г҃сь избави мя и въ словесех гор-",
            "bbox_xywh": [
              106,
              1472,
              936,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i230-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-brothers-l020",
            "text": "ькыхъ Егуптяныни изят мя. тоже и страсть приемлю ми ѿ",
            "bbox_xywh": [
              106,
              1507,
              936,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 53,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i230-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-brothers-l021",
            "text": "жены скверны,⁵) нудящю ми съгрѣшити с нею, но Бъ҃ ѡц҃а моего",
            "bbox_xywh": [
              106,
