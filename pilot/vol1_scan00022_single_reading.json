                "uncertain": false
              }
            ]
          },
          {
            "id": "note-line-04",
            "text": "сумнївним, чи конечно Курбський був їх автором. У моїх руках знаходить ся руко-",
            "bbox_xywh": [
              140,
              1067,
              953,
              26
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
