                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "note-line-07",
            "text": "клад без сумнїву значно старший, без слїдів білорущини, які мають знаходитись",
            "bbox_xywh": [
              140,
              1154,
              953,
              26
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt6-single-20261111-v1s00022",
