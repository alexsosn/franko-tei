                "start": 0,
                "end": 79,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "note-line-05",
            "text": "писний переклад деяких творів св. Івана Дамаскина; рукопис (власність проф. О.",
            "bbox_xywh": [
              140,
              1096,
              953,
              26
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
