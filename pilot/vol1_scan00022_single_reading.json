                "uncertain": false
              }
            ]
          },
          {
            "id": "note-line-03",
            "text": "ности I, 545; Соловьевъ, Исторія Россіи VII, 218), та мінї видаєть ся троха",
            "bbox_xywh": [
              140,
              1038,
              953,
              26
            ],
            "geometry_estimated": true,
            "language_spans": [
