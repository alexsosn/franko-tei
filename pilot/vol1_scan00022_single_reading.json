                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "note-line-06",
            "text": "Левицького в Станіславові) походить з початку XVII. а може ще з XVI. віку; пере-",
            "bbox_xywh": [
              140,
              1125,
              953,
              26
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt6-single-20261111-v1s00022",
