                "language": "uk",
                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "note-line-10",
            "text": "справдї остро виступав проти апокріфічних оповідань і жалував ся на їх популяр-",
            "bbox_xywh": [
              140,
              1241,
              953,
              26
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt6-single-20261111-v1s00022",
                "start": 0,
                "end": 79,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "note-line-11",
            "text": "ність у литовській Руси, пишучи з відси до одного московського монаха: „Противно",
            "bbox_xywh": [
              140,
              1270,
              953,
              26
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt6-single-20261111-v1s00022",
                "start": 0,
                "end": 71,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false
              },
              {
