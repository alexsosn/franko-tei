                "start": 71,
                "end": 80,
                "language": "ru",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "note-line-12",
            "text": "си лжесловесници, преобразующися въ истовые учители, и пишуть повѣсть со-",
            "bbox_xywh": [
              140,
              1299,
              953,
              26
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt6-single-20261111-v1s00022",
                "start": 0,
                "end": 73,
                "language": "ru",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "note-line-13",
            "text": "противъ євангельскимъ словесемъ, и имена своя скривше, да не обличени будутъ,",
            "bbox_xywh": [
              140,
              1328,
              953,
              26
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt6-single-20261111-v1s00022",
                "start": 0,
                "end": 77,
                "language": "ru",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "note-line-14",
            "text": "и подписують ихъ на святыхъ имена, да удобно ихъ писаніе пріймется простыми",
            "bbox_xywh": [
              140,
              1357,
              953,
              26
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt6-single-20261111-v1s00022",
                "start": 0,
                "end": 75,
                "language": "ru",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "note-line-15",
            "text": "и неучеными. Али не слышалъ еси, какову бѣду отъ таковыхъ въ литовской земли",
            "bbox_xywh": [
              140,
              1386,
              953,
              26
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt6-single-20261111-v1s00022",
                "start": 0,
                "end": 76,
                "language": "ru",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "note-line-16",
            "text": "церковь Божія пріемлетъ? Апостольскія слова превращаются, развращеніе толкуютъ,",
            "bbox_xywh": [
              140,
              1415,
              953,
              26
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt6-single-20261111-v1s00022",
                "start": 0,
                "end": 79,
                "language": "ru",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "note-line-17",
            "text": "на святыхъ хулу полагаютъ. И отъ книгъ русскихъ емлющи словеса развращенныя,",
            "bbox_xywh": [
              140,
              1444,
              953,
              26
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt6-single-20261111-v1s00022",
                "start": 0,
                "end": 76,
                "language": "ru",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "note-line-18",
            "text": "отъ Єремеи попа болгарскаго сложены и иныхъ таковыхъ и на Златоустаго имя",
            "bbox_xywh": [
              140,
              1473,
              953,
              26
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt6-single-20261111-v1s00022",
                "start": 0,
                "end": 73,
                "language": "ru",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "note-line-19",
            "text": "подписано и на иныхъ святыхъ, яко щиты себе носить и изъ за нихъ на законъ",
            "bbox_xywh": [
              140,
              1502,
              953,
              26
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt6-single-20261111-v1s00022",
                "start": 0,
                "end": 74,
                "language": "ru",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "note-line-20",
            "text": "Христовъ поруганіи и хуланіи стрѣляють“ (Православный Собесѣдникъ 1863, т. II).",
