                "language": "uk",
                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "note-line-08",
            "text": "в перекладі Курбського, і отсї слова, так як їх вище виписано, знаходять ся на кінцї",
            "bbox_xywh": [
              140,
              1183,
              953,
              26
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt6-single-20261111-v1s00022",
                "start": 0,
                "end": 84,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "note-line-09",
            "text": "короткого послїслові до Дамаскинового твору „О єресяхъ“. Впрочім Курбський",
            "bbox_xywh": [
              140,
              1212,
              953,
              26
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
