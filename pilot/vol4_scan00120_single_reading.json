                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-30",
            "text": "и всего, що тилко себѣ жадаєте, дамъ вамъ.",
            "bbox_xywh": [
              146,
              1217,
              963,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
