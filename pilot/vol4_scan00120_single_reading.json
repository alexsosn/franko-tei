                "start": 0,
                "end": 58,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-32",
            "text": "лодомъ и страшною вѣчною и различними допꙋстами. Подꙋщꙋ",
            "bbox_xywh": [
              146,
              1289,
              963,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-120-image-20261126",
                "start": 0,
                "end": 55,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-33",
            "text": "и порꙋшꙋ великихъ царя на царя, пана на пана, мѣсто на мѣсто,",
            "bbox_xywh": [
              146,
              1325,
              963,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-120-image-20261126",
                "start": 0,
                "end": 61,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-34",
            "text": "село на село, отца на сина, сина на отца, брата на сестру, сестру",
            "bbox_xywh": [
              146,
              1360,
              963,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-120-image-20261126",
                "start": 0,
                "end": 65,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-35",
            "text": "на брата, матеръ на дочкꙋ, дочкꙋ на матеръ, мꙋжей на жени,",
            "bbox_xywh": [
              146,
              1396,
              963,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-120-image-20261126",
                "start": 0,
                "end": 58,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-36",
            "text": "жени на мꙋжей, воздвигнꙋ и взбꙋджꙋ многꙋю ненавѣст междꙋ",
            "bbox_xywh": [
              146,
              1432,
              963,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-120-image-20261126",
                "start": 0,
                "end": 56,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-37",
            "text": "вами, крови пролитїє, злости незноснїи, оумножат сѧ заздростъ",
            "bbox_xywh": [
              146,
              1468,
              963,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-120-image-20261126",
                "start": 0,
                "end": 61,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-38",
            "text": "великая противо дрꙋгимъ, и дрꙋгъ отъ дрꙋга ѹтѣкати бꙋдете.",
            "bbox_xywh": [
              146,
              1503,
              963,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-120-image-20261126",
                "start": 0,
                "end": 58,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-39",
            "text": "дѣла рꙋкъ вашихъ великїи вороги забирати бꙋдꙋтъ, и бидло",
            "bbox_xywh": [
              146,
              1539,
              963,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
