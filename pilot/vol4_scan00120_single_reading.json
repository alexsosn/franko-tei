                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-29",
            "text": "детъ на земли вашей, не падетъ на васъ найменшїй страхъ,",
            "bbox_xywh": [
              146,
              1182,
              963,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-120-image-20261126",
