                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-28",
            "text": "ваша от востока слонца до запада, миръ, спокои и згода бꙋ-",
            "bbox_xywh": [
              146,
              1146,
              963,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-120-image-20261126",
