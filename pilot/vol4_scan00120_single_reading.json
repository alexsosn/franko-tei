        ],
        "geometry_estimated": true,
        "lines": [
          {
            "id": "epistle-line-31",
            "text": "„Но єсли приказаня моєго не заховаєте, то оукараю васъ го-",
            "bbox_xywh": [
              146,
              1253,
              963,
              32
