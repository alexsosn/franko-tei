              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-122-image-20261126",
                "start": 0,
                "end": 59,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-27",
            "text": "бж҃ства своєго той листъ писалъ и ѹчилъ, абисте сѧ добре спра-",
            "bbox_xywh": [
              132,
              1105,
              972,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-122-image-20261126",
                "start": 0,
                "end": 62,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-28",
            "text": "вовали на томъ свѣтѣ. бо вамъ далъ шестъ дни роботни, а во",
            "bbox_xywh": [
              132,
              1142,
              972,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-122-image-20261126",
                "start": 0,
                "end": 58,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-29",
            "text": "оденъ седми недѣлю, ѡсвативши єго на доброє дѣло и ꙋчинокъ",
            "bbox_xywh": [
              132,
              1178,
              972,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-122-image-20261126",
                "start": 0,
                "end": 58,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-30",
            "text": "ко ѡпочивни хвали своєй. Я єжели не бꙋдете ведлю моєй заповѣди",
            "bbox_xywh": [
              132,
              1214,
              972,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-122-image-20261126",
                "start": 0,
                "end": 62,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-31",
            "text": "творити, то бꙋдꙋ голодомъ и повитромъ злимъ и войною ка-",
            "bbox_xywh": [
              132,
              1250,
              972,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-122-image-20261126",
                "start": 0,
                "end": 56,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-32",
            "text": "рати, и побꙋджꙋ на васъ цр҃я на цр҃я, короля на короля, пн҃а на",
            "bbox_xywh": [
              132,
              1286,
              972,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-122-image-20261126",
                "start": 0,
                "end": 63,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-33",
            "text": "пн҃а, мѣсто на мѣсто, ѡтецъ на сн҃а, сн҃ъ на ѡтца, братъ на",
            "bbox_xywh": [
              132,
              1322,
              972,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-122-image-20261126",
                "start": 0,
                "end": 59,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-34",
            "text": "брата, мт҃и на дщерꙋ, дщера на мт҃кꙋ свою. и бꙋдетъ межи вами",
            "bbox_xywh": [
              132,
              1358,
              972,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-122-image-20261126",
                "start": 0,
                "end": 61,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-35",
            "text": "великоє кровъпролитїє. всѣхъ васъ ѹхромлю и пищꙋ ѿ васъ ѡимꙋ.",
            "bbox_xywh": [
              132,
              1394,
              972,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-122-image-20261126",
                "start": 0,
                "end": 61,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-36",
            "text": "и бꙋдꙋ єще васъ карати громами и блистанїємъ, абисте познали",
            "bbox_xywh": [
              132,
              1431,
              972,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-122-image-20261126",
                "start": 0,
                "end": 60,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-37",
            "text": "гнѣвъ мой бж҃їй, а то про то, про прегрѣшенїє вш҃е. єще васъ",
            "bbox_xywh": [
              132,
              1467,
              972,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-122-image-20261126",
                "start": 0,
                "end": 60,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-38",
            "text": "напоминаю з ласки моєй ст҃ой, котори єсть дн҃ь недѣля, абисте",
            "bbox_xywh": [
              132,
              1503,
              972,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-122-image-20261126",
                "start": 0,
                "end": 61,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-39",
            "text": "до цр҃кви ходили, а злихъ оучинковъ не творили. єсли не бꙋдете",
            "bbox_xywh": [
              132,
              1539,
              972,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-122-image-20261126",
                "start": 0,
                "end": 62,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          }
        ]
