      },
      {
        "line_id": "witness-c-ending-l005",
        "reading": "бж҃іимъ из горы Сынайской оу сорокъ днїй и въ сорок ночїй,",
        "reason": "Historical typography, diacritics, titla, restorations and language attribution provisional."
      },
      {
        "line_id": "witness-c-ending-l006",
        "reading": "[оувидѣл] Мойсей злое дѣло людїй своихъ [и] жаловал барзо.",
        "reason": "Historical typography, diacritics, titla, restorations and language attribution provisional."
      },
      {
        "line_id": "witness-c-ending-l007",
        "reading": "И рек до Мойсеа Бг҃ъ: „Мойсею, не скорби! Не ты ми просту-",
        "reason": "Historical typography, diacritics, titla, restorations and language attribution provisional."
      },
      {
        "line_id": "witness-c-ending-l008",
        "reading": "пив, але твой люде“. И повелѣлъ ему Бг҃ъ оучинити посредѣ",
        "reason": "Historical typography, diacritics, titla, restorations and language attribution provisional."
      },
      {
        "line_id": "witness-c-ending-l009",
        "reading": "ѡвозу их мѣдяного оужа и повѣсити на деревѣ, и кого оукусит",
        "reason": "Historical typography, diacritics, titla, restorations and language attribution provisional."
      },
      {
        "line_id": "witness-c-ending-l010",
        "reading": "тота гадина, тотъ нехай пришовъши поклякнет на колѣна перед",
        "reason": "Historical typography, diacritics, titla, restorations and language attribution provisional."
      },
      {
        "line_id": "witness-c-ending-l011",
        "reading": "тым столпомъ, на котором то висѣлъ оужъ мѣдяный и там",
        "reason": "Historical typography, diacritics, titla, restorations and language attribution provisional."
      },
