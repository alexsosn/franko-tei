                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "fridays-line-30",
            "text": "сн҃ъ Малхъ зостал сѧ з нашим хрⷭтїанином. И рече Єзерїй Мал-",
            "bbox_xywh": [
              98,
              1304,
              967,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-133-image-20261126",
