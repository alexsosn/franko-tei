                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "fridays-line-31",
            "text": "хови: „Ци вѣдаєш ти, що твой ѿц҃ъ мовилъ ѡ ві҃. пятницах?“",
            "bbox_xywh": [
              98,
              1339,
              967,
              32
