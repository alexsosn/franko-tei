          },
          {
            "id": "fridays-line-34",
            "text": "дѣди жили, кꙋпили въ Іуди апоⷭтола Іс҃а Хрⷭта вашего за л҃. сре-",
            "bbox_xywh": [
              98,
              1445,
              967,
              32
