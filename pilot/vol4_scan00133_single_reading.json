                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "fridays-line-35",
            "text": "бниковъ. И взяли єго на страсть, и нашли в него картꙋ, на",
            "bbox_xywh": [
              98,
              1481,
              967,
              32
