                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "fridays-line-29",
            "text": "вин ѿ горести ср҃дца своєго изийде вонъ ѹдаривши дверми, а єго",
            "bbox_xywh": [
              98,
              1268,
              967,
              32
