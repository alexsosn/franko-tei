          "line_id": "witness-g-apparatus-l001",
          "start": 57,
          "end": 76,
          "literal": "⁷) зам сего є: тако"
        },
        {
          "scan_page": 166,
          "line_id": "witness-g-apparatus-l002",
          "start": 0,
          "end": 44,
          "literal": "ꙗкож[е] имаше заповѣдь. и възрастоша главнѣ "
        }
      ]
    },
    {
      "id": "v1-section-x-g-entry-008-01",
      "number": 8,
      "label": "⁸)",
      "fragments": [
        {
          "scan_page": 166,
          "line_id": "witness-g-apparatus-l002",
          "start": 44,
          "end": 82,
          "literal": "⁸) зам. сего: и быс[ть] древо и велико"
        },
        {
          "scan_page": 166,
          "line_id": "witness-g-apparatus-l003",
          "start": 0,
          "end": 9,
          "literal": "и красно "
        }
