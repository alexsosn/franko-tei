    "uncertainty_notes": [
      {
        "line_id": "adarian-l001",
        "reading": "[Оповіданє про царя Адаріяна]. По сем нача молвити Соло-",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "adarian-l002",
        "reading": "монъ бояромъ своим: „быс[ть] Адарїянъ цр҃ь и повеле бояромъ",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "adarian-l003",
        "reading": "свои[м] звати с[я] бг҃омъ. и не въсхотеша бояри ег[о], рѣша:",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "adarian-l004",
        "reading": "„цр҃ю нш҃ь, мниши ли въ ср҃дци своемь, яко не было Ба҃ преж[е]",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "adarian-l005",
        "reading": "тебе? аще прозовемь тя вышнимь, цр҃емь въ цр҃ехъ, єгда прий-",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "adarian-l006",
        "reading": "меши вышний Єрлм҃ъ и ст҃аа ст҃хъ?“ ѡнь же причинив ся съ вои",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "adarian-l007",
        "reading": "многым[и] и шедъ пріят Ієрлм҃ъ и възвратив ся вспят рече",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "adarian-l008",
        "reading": "имъ: „яко ж[е] Бг҃ъ велит и речет, також[е] и сътворит. також[е]",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "adarian-l009",
        "reading": "и азъ сътворих, нн҃ѣ же взовете мя бг҃омъ“. имаше же три фи-",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "adarian-l010",
        "reading": "лософ[и]. Ѡвѣща ему а҃. реч[е] ему: „аще хощеши възвати с[я]",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "adarian-l011",
        "reading": "бг҃омъ, да нѣс[ть] възвати ся боярину въ цр҃ве полат[е] цр҃емь,",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "adarian-l012",
        "reading": "а не выступити вънъ. тако и ты аще хощеши възвати с[я] бг҃омъ,",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "adarian-l013",
        "reading": "да выступи изо вселеныя всея и тамо взови ся бг҃омъ“. и реч[е]",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "adarian-l014",
        "reading": "другый: „не можеши ты възвати ся бг҃омъ“. и реч[е] цр҃ь: „чему?“",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "adarian-l015",
        "reading": "ѡн же реч[е]: „гл҃етъ Ієремея пророкъ: бзи не створшии нб҃си",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "adarian-l016",
        "reading": "и земли да погыбнутъ. аще хощеши погынути, цр҃ю, то възови",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "adarian-l017",
        "reading": "ся бг҃омъ“. и реч[е] трет[ї]и: „гд҃нѣ мои цр҃ю! помози ми в час",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "adarian-l018",
        "reading": "сии вьскоре!“ и реч[е] цр҃ь: „что ти єсть?“ и реч[е] философъ:",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "adarian-l019",
        "reading": "„яко лодья моя за трими верстами хощеть погрязнути, а все",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "adarian-l020",
        "reading": "именїє мое в неи“. и реч[е] цр҃ь: „не бои ся, послю люди и при-",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "adarian-l021",
        "reading": "ведутъ ю“. и рече философ: „чему, цр҃ю, трудиши люди своя?",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "adarian-l022",
        "reading": "посли вѣтръ тихъ, да спасеть ю“. ѡнже разумѣвъ помолъче не-",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "adarian-l023",
        "reading": "любьемъ и иде къ цр҃ци в полату. и реч[е] цр҃ца: „философи",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "adarian-l024",
        "reading": "съблазниша тя, цр҃ю, рѣша ти, як[о] не можеши звати с[я]",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "adarian-l025",
        "reading": "бг҃омъ“. хотевши же ему утешенїє дати по печали той и реч[е]:",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "adarian-l026",
        "reading": "„ты єси цр҃ь, ты єс[и] бг҃атъ, ты достоинъ чс҃ти великыя. створи",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
      },
      {
        "line_id": "adarian-l027",
        "reading": "реч єдину [в ркп. хибно: єдино], тогда взови ся бг҃омъ“. и реч[е]",
        "reason": "Historical type: exact titla, breathings, diacritics and glyphs provisional."
