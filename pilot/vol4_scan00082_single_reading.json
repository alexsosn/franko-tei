                "uncertain": true
              }
            ]
          },
          {
            "id": "lucidarius-line-29",
            "text": "рѣют сѧ, а през старосⷮ свою не могут ни ходити ни сидѣти,",
            "bbox_xywh": [
              135,
              1175,
              940,
