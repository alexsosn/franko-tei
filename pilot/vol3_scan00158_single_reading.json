        "geometry_estimated": true,
        "lines": [
          {
            "id": "body-7-line-01",
            "text": "Тамъ Киноѱъ призвал до себе единого воеводѹ, оу кото-",
            "bbox_xywh": [
              146,
              1342,
              963,
              34
