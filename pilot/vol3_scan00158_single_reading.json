            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00158-20261126",
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "start": 0,
                "end": 53
              }
            ]
          },
          {
            "id": "body-6-line-02",
            "text": "а не через мене самого. ѡ Бга҃ вся возможна, а не ѡ чл҃вѣкъ.",
            "bbox_xywh": [
              146,
              1233,
              963,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00158-20261126",
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "start": 0,
                "end": 60
              }
            ]
          },
          {
            "id": "body-6-line-03",
            "text": "Претож покажы ми свое дѣло и мѹдрость, нехай бѹдемо оушит'-",
            "bbox_xywh": [
              146,
              1267,
              963,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00158-20261126",
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "start": 0,
                "end": 59
              }
            ]
          },
          {
            "id": "body-6-line-04",
            "text": "ки видѣти“.",
            "bbox_xywh": [
              146,
              1301,
              963,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00158-20261126",
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
