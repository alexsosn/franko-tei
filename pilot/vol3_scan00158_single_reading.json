        "geometry_estimated": true,
        "lines": [
          {
            "id": "body-6-line-01",
            "text": "Рек Киноѱови Іѡан: „Моя моцъ и сила сѹт оу Ха҃ моего,",
            "bbox_xywh": [
              146,
              1199,
              963,
              34
