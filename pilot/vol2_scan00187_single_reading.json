      {
        "id": "erodius",
        "kind": "body",
        "bbox_xywh": [
          73,
          1183,
          946,
          359
        ],
        "geometry_estimated": true,
        "lines": [
          {
            "id": "erodius-line-01",
            "text": "Еще єст оу ѣн'дѣйских сторонах оу҆ пꙋщах єдин звѣръ",
            "language_spans": [
              {
                "text_version": "gpt62-ii-187-atlas-20261128",
                "start": 0,
                "end": 51,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ],
            "bbox_xywh": [
              73,
              1183,
              946,
              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "erodius-line-02",
            "text": "чꙋдный и҆ див'ный, которомꙋ то и҆мя Єродїй албо, якъ тамош'-",
            "language_spans": [
              {
                "text_version": "gpt62-ii-187-atlas-20261128",
                "start": 0,
                "end": 60,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ],
            "bbox_xywh": [
              73,
              1218,
              946,
              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "erodius-line-03",
            "text": "ный люде их зовꙋтъ его, боцанъ, которого то споминает цр҃ь",
            "language_spans": [
              {
                "text_version": "gpt62-ii-187-atlas-20261128",
                "start": 0,
                "end": 58,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ],
            "bbox_xywh": [
              73,
              1254,
              946,
              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "erodius-line-04",
            "text": "Давыдъ [на марґ. дод. ѱалом рг҃.]: „Єродїєво жилище“. Але не",
            "language_spans": [
              {
                "text_version": "gpt62-ii-187-atlas-20261128",
                "start": 0,
                "end": 8,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              },
              {
                "text_version": "gpt62-ii-187-atlas-20261128",
                "start": 8,
                "end": 21,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false
              },
              {
                "text_version": "gpt62-ii-187-atlas-20261128",
                "start": 21,
                "end": 60,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ],
            "bbox_xywh": [
              73,
              1290,
              946,
              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "erodius-line-05",
            "text": "в' сих то пꙋщах боцаны ся плодят и҆ знайдꙋютъ, бо тот бо-",
            "language_spans": [
              {
                "text_version": "gpt62-ii-187-atlas-20261128",
                "start": 0,
                "end": 57,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ],
            "bbox_xywh": [
              73,
              1326,
              946,
              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "erodius-line-06",
            "text": "цан страшен єст', ноги ємꙋ як' шарканіовы, а ног'ты ємꙋ ѡ҆стры,",
            "language_spans": [
              {
                "text_version": "gpt62-ii-187-atlas-20261128",
                "start": 0,
                "end": 63,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ],
            "bbox_xywh": [
              73,
              1362,
              946,
              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "erodius-line-07",
            "text": "же то ажъ оу҆ камѣнь оустравают, а сам дов'гїй а товстый",
            "language_spans": [
              {
                "text_version": "gpt62-ii-187-atlas-20261128",
                "start": 0,
                "end": 56,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ],
            "bbox_xywh": [
              73,
              1398,
              946,
              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "erodius-line-08",
            "text": "и҆ крꙋглый як боч'ка и҆ грꙋбый бар'зо єст боцанъ, а по двоє дѣ-",
            "language_spans": [
              {
                "text_version": "gpt62-ii-187-atlas-20261128",
                "start": 0,
                "end": 63,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ],
            "bbox_xywh": [
              73,
              1434,
              946,
              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "erodius-line-09",
            "text": "тїй плодит. А той боцанъ свѣта не любитъ и҆ слн҃це ємꙋ ш'ко-",
            "language_spans": [
              {
                "text_version": "gpt62-ii-187-atlas-20261128",
                "start": 0,
                "end": 60,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ],
            "bbox_xywh": [
              73,
              1470,
              946,
              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "erodius-line-10",
            "text": "дитъ. А такїй ѡ҆бычай той Єродїй маєт: оу҆ дн҃ь а ѡн лежит'",
            "language_spans": [
              {
                "text_version": "gpt62-ii-187-atlas-20261128",
                "start": 0,
                "end": 59,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ],
            "bbox_xywh": [
              73,
              1506,
              946,
              33
            ],
            "geometry_estimated": true
          }
        ]
      },
