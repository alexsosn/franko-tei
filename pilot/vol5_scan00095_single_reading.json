              }
            ]
          },
          {
            "id": "body-7-line-08",
            "text": "виша ся¹). и рече цр҃ца: нн҃ѣ виждꙋ въ истиннꙋ, ꙗко Бъ҃ хрестї-",
            "bbox_xywh": [
              106,
              1063,
