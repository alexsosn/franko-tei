            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 55,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00095-20261126"
              }
            ]
          },
          {
            "id": "body-8-line-02",
            "text": "великого ба҃ Апполина и принесѣва емꙋ жертвы. и повелѣ събра-",
            "bbox_xywh": [
              107,
              1242,
              992,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
