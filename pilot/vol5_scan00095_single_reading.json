        ],
        "geometry_estimated": true,
        "lines": [
          {
            "id": "body-8-line-01",
            "text": "По семъ вниде цр҃ь къ ст҃омꙋ и рече: Пойдѣва въ цр҃ковь",
            "bbox_xywh": [
              107,
              1206,
              992,
              34
