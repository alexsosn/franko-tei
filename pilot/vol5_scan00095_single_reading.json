                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00095-20261126"
              }
            ]
          },
          {
            "id": "body-8-line-03",
            "text": "ти ся кнѧземъ и велможамъ и всѣмъ людемъ на радость, ꙗко",
            "bbox_xywh": [
              107,
              1278,
              992,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 56,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00095-20261126"
              }
            ]
          },
          {
            "id": "body-8-line-04",
            "text": "Геѡргій хощет оуже вѣровати Апполинꙋ. иже съшедшимъ ся на-",
            "bbox_xywh": [
              107,
              1314,
              992,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 58,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00095-20261126"
              }
            ]
          },
          {
            "id": "body-8-line-05",
            "text": "родомъ вниде ст҃ый въ церковь и веліимъ гласомъ рече: Бѣжи-",
            "bbox_xywh": [
              107,
              1350,
              992,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 59,
                "language": "cu",
