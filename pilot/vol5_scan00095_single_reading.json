            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 57,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00095-20261126"
              }
            ]
          },
          {
            "id": "body-7-line-10",
            "text": "мл҃ю тя, Геѡргіе, наоучи мя сътворити мл҃твꙋ, да ѿстꙋпитъ ѿ",
            "bbox_xywh": [
              106,
              1135,
              992,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00095-20261126"
              }
            ]
          },
          {
            "id": "body-7-line-11",
            "text": "мене діаволскаѧ лесть. и сїе рекши оумолча.",
            "bbox_xywh": [
              106,
              1171,
              992,
              34
            ],
