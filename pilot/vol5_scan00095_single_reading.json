                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00095-20261126"
              }
            ]
          },
          {
            "id": "body-7-line-09",
            "text": "анскїй великъ есть, наши же бози діаволи, ничтож соут. но",
            "bbox_xywh": [
              106,
              1099,
              992,
              34
