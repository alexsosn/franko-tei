            "id": "council-line-08",
            "text": "Бх҃ знаменія, томоу боудет дв҃ца“. и҆ поидоша проповѣдници по",
            "language_spans": [
              {
                "text_version": "gpt62-ii-183-atlas-20261128",
                "start": 0,
                "end": 61,
