            ],
            "geometry_estimated": true
          },
          {
            "id": "joseph-line-08",
            "text": "рекоша ємоу ієреи: „Іѡсифе, оу҆бой ся Ба҃ сіє гл҃ати! помисли,",
            "language_spans": [
              {
                "text_version": "gpt62-ii-183-atlas-20261128",
                "start": 0,
                "end": 62,
                "language": "orv",
                "script": "Cyrl",
