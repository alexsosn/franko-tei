              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "joseph-line-05",
            "text": "и҆ рече: „на тобѣ паде жребій, пойми дв҃цꙋ ѿ цр҃кве на съблюде-",
            "language_spans": [
              {
                "text_version": "gpt62-ii-183-atlas-20261128",
                "start": 0,
                "end": 63,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
