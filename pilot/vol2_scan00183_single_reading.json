            ],
            "geometry_estimated": true
          },
          {
            "id": "joseph-line-06",
            "text": "ніє єя“. и҆ рече Іѡсифъ против ієреов: „азъ єсмъ стар, а сія",
            "language_spans": [
              {
                "text_version": "gpt62-ii-183-atlas-20261128",
                "start": 0,
                "end": 60,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
