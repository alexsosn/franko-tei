      {
        "id": "jeremiah-opening",
        "kind": "body",
        "bbox_xywh": [
          118,
          1160,
          950,
          426
        ],
        "geometry_estimated": true,
        "lines": [
          {
            "id": "jeremiah-opening-l001",
            "text": "И поят Іѡананъ и вся въєводы, силы вся ѡставльшыя Ію-",
            "bbox_xywh": [
              118,
              1160,
              950,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 53,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i380-first-image-20261125"
              }
            ]
          },
          {
            "id": "jeremiah-opening-l002",
            "text": "дины євращеныя жити на земли, мужа силныя и млад[е]нца",
            "bbox_xywh": [
              118,
              1195,
              950,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 54,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i380-first-image-20261125"
              }
            ]
          },
          {
            "id": "jeremiah-opening-l003",
            "text": "и дщери цр҃я и дша҃ яже ѡстави Навузарданъ с Годолїемъ сн҃мъ",
            "bbox_xywh": [
              118,
              1231,
              950,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 60,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i380-first-image-20261125"
              }
            ]
          },
          {
            "id": "jeremiah-opening-l004",
            "text": "Ахикамомъ, и Єремеа пр҃рока и Варуха сн҃а Нирїина, и внидоша",
            "bbox_xywh": [
              118,
              1266,
              950,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 60,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i380-first-image-20261125"
              }
            ]
          },
          {
            "id": "jeremiah-opening-l005",
            "text": "въ Єгупет, яко не послушаша глас[а] Гня҃. и внидоша в Тафаисъ",
            "bbox_xywh": [
              118,
              1302,
              950,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 61,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i380-first-image-20261125"
              }
            ]
          },
          {
            "id": "jeremiah-opening-l006",
            "text": "и приста[ша] к мерзостям египетским и жены ихъ и кажаху",
            "bbox_xywh": [
              118,
              1337,
              950,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 55,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i380-first-image-20261125"
              }
            ]
          },
          {
            "id": "jeremiah-opening-l007",
            "text": "цр҃ци нбснеи, възливаху єй възливанїє и кажаху, яко и мужемъ",
            "bbox_xywh": [
              118,
              1373,
              950,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 60,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i380-first-image-20261125"
              }
            ]
          },
          {
            "id": "jeremiah-opening-l008",
            "text": "их пристати к нимъ. и быс[ть] слово Гнє҃ къ Єремїи: „се азъ",
            "bbox_xywh": [
              118,
              1409,
              950,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i380-first-image-20261125"
              }
            ]
          },
          {
            "id": "jeremiah-opening-l009",
            "text": "преставляю лице своє якож[е] погубити вся Іюдея бежавшыя",
            "bbox_xywh": [
              118,
              1444,
              950,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 56,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i380-first-image-20261125"
              }
            ]
          },
          {
            "id": "jeremiah-opening-l010",
            "text": "въ Єгупет, и падутъ с[я] мечем и гладомъ, оскудѣют даже ѿ мала",
            "bbox_xywh": [
              118,
              1480,
              950,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 62,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i380-first-image-20261125"
              }
            ]
          },
          {
            "id": "jeremiah-opening-l011",
            "text": "и до велик[а]. якож[е] ся ти надеютъ дшами своим[и] възвра-",
            "bbox_xywh": [
              118,
              1515,
              950,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i380-first-image-20261125"
              }
            ]
          },
          {
            "id": "jeremiah-opening-l012",
            "text": "ти[ти] с[я] на землю Іюдину, не възвратят ся тамо ни уцелеют“",
            "bbox_xywh": [
              118,
              1551,
              950,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
