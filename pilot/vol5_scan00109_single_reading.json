                "uncertain": false,
                "text_version": "gpt62-v5s00109-20261126"
              }
            ]
          },
          {
            "id": "body-3-line-11",
            "text": "еже оубо тѣми нам цр҃ство, чл҃ком же всѣмъ сп҃снїе дарова ся.",
            "bbox_xywh": [
              104,
              1270,
