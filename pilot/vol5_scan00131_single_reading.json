                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00131-20261127"
              }
            ]
          },
          {
            "id": "body-4-line-03",
            "text": "быти Гоу҃ Боу҃. и видѣлъ въ снѣ крст҃ъ стоячїй над главою его.",
            "bbox_xywh": [
              108,
              1541,
              978,
              31
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 62,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00131-20261127"
              }
            ]
          },
          {
            "id": "body-4-line-04",
            "text": "и въставше ѿ сна и поклони ся крст҃оу. На оутрѣй же дн҃ь хо-",
            "bbox_xywh": [
              108,
              1579,
              978,
              31
            ],
            "geometry_estimated": true,
            "language_spans": [
