        "geometry_estimated": true,
        "lines": [
          {
            "id": "body-4-line-01",
            "text": "Былъ моуж благовѣрный именем Никита, сн҃ъ цр҃я Маѯи-",
            "bbox_xywh": [
              108,
              1465,
              978,
              31
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 52,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00131-20261127"
              }
            ]
          },
          {
            "id": "body-4-line-02",
            "text": "мїана. и любил крст҃ъ Хс҃въ велми, понеже сосуд избранен хотѣлъ",
            "bbox_xywh": [
              108,
              1503,
              978,
              31
            ],
            "geometry_estimated": true,
            "language_spans": [
