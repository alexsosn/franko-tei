                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00102-20261126"
              }
            ]
          },
          {
            "id": "body-2-line-15",
            "text": "цр҃ь: колко ти лѣт ест, онелѣ же еси оумерлъ? он же рече емꙋ:",
            "bbox_xywh": [
              105,
              1340,
