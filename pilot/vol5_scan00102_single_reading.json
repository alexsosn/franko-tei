            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 63,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00102-20261126"
              }
            ]
          },
          {
            "id": "body-2-line-22",
            "text": "имѧ гс҃не, аще имаеть грѣхи многы, то покои имаеть во дн҃ь не-",
            "bbox_xywh": [
              105,
              1600,
