            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 62,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00102-20261126"
              }
            ]
          },
          {
            "id": "body-2-line-23",
            "text": "дѣлныи. а мы ни в недѣлю не имѣхомъ покоѧ, зане отметахом",
            "bbox_xywh": [
