                "uncertain": false,
                "text_version": "gpt62-v5s00102-20261126"
              }
            ]
          },
          {
            "id": "body-2-line-16",
            "text": "т҃. лѣт и болеи. и рече цр҃ь: слѣзалъ ли бяше Хс҃ оу та лѣта? и рече",
            "bbox_xywh": [
              105,
              1377,
              1002,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
