                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00102-20261126"
              }
            ]
          },
          {
            "id": "body-2-line-20",
            "text": "дѣла своѧ, и воспрїимете мздꙋ свою. послꙋшаи цр҃ю, исповѣм ти",
            "bbox_xywh": [
              105,
              1526,
