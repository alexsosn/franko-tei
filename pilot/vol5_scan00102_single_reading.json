                "text_version": "gpt62-v5s00102-20261126"
              }
            ]
          },
          {
            "id": "body-2-line-14",
            "text": "что ти имѧ ест? Ѿвѣщав же и рече: азъ есмь Девикосъ. и рече емꙋ",
            "bbox_xywh": [
              105,
              1303,
              1002,
