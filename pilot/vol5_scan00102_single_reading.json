                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00102-20261126"
              }
            ]
          },
          {
            "id": "body-2-line-17",
            "text": "емꙋ: не бысть тогда имене Хс҃ва. и рече цр҃ь: коего еси Ба҃ молилъ?",
            "bbox_xywh": [
              105,
              1414,
              1002,
              35
