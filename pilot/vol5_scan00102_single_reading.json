                "text_version": "gpt62-v5s00102-20261126"
              }
            ]
          },
          {
            "id": "body-2-line-13",
            "text": "жень и троє дѣтїи. и видѣ цр҃ь призва єдиного ѿ тѣх и рече:",
            "bbox_xywh": [
              105,
              1266,
