                "start": 0,
                "end": 61,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00102-20261126"
              }
            ]
          },
          {
            "id": "body-2-line-21",
            "text": "все, еже бысть мнѣ. всѧкъ чл҃къ родивыи ся ѿ мт҃ре и вѣрꙋеть во",
            "bbox_xywh": [
              105,
              1563,
              1002,
