              }
            ]
          },
          {
            "id": "body-2-line-12",
            "text": "свѣт великъ над перстїю, и абїа восташа д҃. сот мꙋжїи и д҃. сот",
            "bbox_xywh": [
              105,
              1228,
              1002,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
