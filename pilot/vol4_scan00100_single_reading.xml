="zone-v4-s00100-line-body-line-02" /><zone ulx="135" uly="238" lrx="1090" lry="265" type="estimated" xml:id="zone-v4-s00100-line-body-line-03" /><zone ulx="135" uly="274" lrx="1090" lry="301" type="estimated" xml:id="zone-v4-s00100-line-body-line-04" /><zone ulx="135" uly="310" lrx="1090" lry="337" type="estimated" xml:id="zone-v4-s00100-line-body-line-05" /><zone ulx="135" uly="346" lrx="1090" lry="373" type="estimated" xml:id="zone-v4-s00100-line-body-line-06" /><zone ulx="135" uly="382" lrx="1090" lry="409" type="estimated" xml:id="zone-v4-s00100-line-body-line-07" /><zone ulx="135" uly="418" lrx="1090" lry="445" type="estimated" xml:id="zone-v4-s00100-line-body-line-08" /><zone ulx="135" uly="454" lrx="1090" lry="481" type="estimated" xml:id="zone-v4-s00100-line-body-line-09" /><zone ulx="135" uly="490" lrx="1090" lry="517" type="estimated" xml:id="zone-v4-s00100-line-body-line-10" /><zone ulx="135" uly="526" lrx="1090" lry="553" type="estimated" xml:id="zone-v4-s00100-line-body-line-11" /><zone ulx="135" uly="562" lrx="1090" lry="589" type="estimated" xml:id="zone-v4-s00100-line-body-line-12" /></zone></surface></facsimile><text><body><div type="page" n="100" facs="#surface-v4-s00100" xml:id="page-v4-s00100"><pb n="100" facs="#surface-v4-s00100" /><ab type="page_number" facs="#zone-v4-s00100-region-page-number" xml:id="ab-v4-s00100-page-number"><lb facs="#zone-v4-s00100-line-page-number-line" xml:id="lb-v4-s00100-page-number-line" />48</ab><ab type="body" facs="#zone-v4-s00100-region-editorial-prose" xml:id="ab-v4-s00100-editorial-prose"><lb facs="#zone-v4-s00100-line-body-line-01" xml:id="lb-v4-s00100-body-line-01" /><seg type="language-attribution" xml:lang="uk">части просто взяті з </seg><seg type="language-attribution" xml:lang="ru" cert="low">„Бесѣды трехъ святителей“</seg><seg type="language-attribution" xml:lang="uk">. Інтересно, що</seg><lb facs="#zone-v4-s00100-line-body-line-02" xml:id="lb-v4-s00100-body-line-02" /><seg type="language-attribution" xml:lang="uk">сам автор сього катехізма видїлює ті питання окремо від попереднїх,</seg><lb facs="#zone-v4-s00100-line-body-line-03" xml:id="lb-v4-s00100-body-line-03" /><seg type="language-attribution" xml:lang="uk">шкільних, і називає їх (пит. 26) </seg><seg type="language-attribution" xml:lang="ru" cert="low">„квестиями людей посполитыхъ“</seg><seg type="language-attribution" xml:lang="uk">,</seg><lb facs="#zone-v4-s00100-line-body-line-04" xml:id="lb-v4-s00100-body-line-04" /><seg type="language-attribution" xml:lang="uk">натякаючи сим на значне розповсюдженє подібних питань і відпо-</seg><lb facs="#zone-v4-s00100-line-body-line-05" xml:id="lb-v4-s00100-body-line-05" /><seg type="language-attribution" xml:lang="uk">відий серед простого народу. Отсей твір, очевидно скомпонований</seg><lb facs="#zone-v4-s00100-line-body-line-06" xml:id="lb-v4-s00100-body-line-06" /><seg type="language-attribution" xml:lang="uk">на те, щоб його виставлено прилюдно живими особами підчас до-</seg><lb facs="#zone-v4-s00100-line-body-line-07" xml:id="lb-v4-s00100-body-line-07" /><seg type="language-attribution" xml:lang="uk">річного екзамену в якійсь братській школї, де були присутні й ро-</seg><lb facs="#zone-v4-s00100-line-body-line-08" xml:id="lb-v4-s00100-body-line-08" /><seg type="language-attribution" xml:lang="uk">дичі дїтий, був опублїкований мною із сього самого рукопису (тодї</seg><lb facs="#zone-v4-s00100-line-body-line-09" xml:id="lb-v4-s00100-body-line-09" /><seg type="language-attribution" xml:lang="uk">він був у депозитї в Ставропігійській бібліотецї, тепер лежить</seg><lb facs="#zone-v4-s00100-line-body-line-10" xml:id="lb-v4-s00100-body-line-10" /><seg type="language-attribution" xml:lang="uk">у бібліотецї свв. Онуфрейського манастиря у Львові) в </seg><seg type="language-attribution" xml:lang="ru" cert="low">„Кіевской</seg><lb facs="#zone-v4-s00100-line-body-line-11" xml:id="lb-v4-s00100-body-line-11" /><seg type="language-attribution" xml:lang="ru" cert="low">Старинѣ“</seg><seg type="language-attribution" xml:lang="uk"> 1892 р., за цьвітень стор. 59—70. На жаль, для отсего</seg><lb facs="#zone-v4-s00100-line-body-line-12" xml:id="lb-v4-s00100-body-line-12" /><seg type="language-attribution" xml:lang="uk">нового виданя я не міг на ново переглянути рукопису.</seg></ab><note type="agent-reading-uncertainty" corresp="#lb-v4-s00100-body-line-02" xml:id="agent-note-v4-s00100-001">видїлює: Working image reading; needs second blind check</note><note type="agent-reading-uncertainty" corresp="#lb-v4-s00100-body-line-10" xml:id="agent-note-v4-s00100-002">свв.: Abbreviation indistinct at image scale; do not silently normalize</note><note type="agent-reading-uncertainty" corresp="#lb-v4-s00100-body-line-11" xml:id="agent-note-v4-s00100-003">цьвітень: Historical orthography retained; needs review</note></div></body></text></TEI>
