                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i357-first-image-20261125"
              }
            ]
          },
          {
            "id": "two-headed-servant-l007",
            "text": "моужь той. въспроша же с[я] его²) Соломон: „которых люд[ии]",
            "bbox_xywh": [
              167,
              1374,
              919,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
