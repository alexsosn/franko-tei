                "text_version": "gpt62-i357-first-image-20261125"
              }
            ]
          },
          {
            "id": "two-headed-servant-l008",
            "text": "еси ты? чл҃къ ли єси ты или бѣсъ?“ ѡвѣща³) ѡнь: „чл҃къ азъ",
            "bbox_xywh": [
              167,
