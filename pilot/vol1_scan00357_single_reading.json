                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i357-first-image-20261125"
              }
            ]
          },
          {
            "id": "two-headed-servant-l005",
            "text": "Китовраса. Китоврасъ же пойде въ свой люд, и дасть Соломону",
            "bbox_xywh": [
              167,
              1304,
              919,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
