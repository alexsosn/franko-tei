                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i357-first-image-20261125"
              }
            ]
          },
          {
            "id": "two-headed-servant-l004",
            "text": "два домы: храм Гнь҃ и домъ цр҃въ. и тогда ѡпусти Соломонъ",
            "bbox_xywh": [
              167,
              1269,
              919,
              33
