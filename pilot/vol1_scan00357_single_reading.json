                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i357-first-image-20261125"
              }
            ]
          },
          {
            "id": "two-headed-servant-l003",
            "text": "иж[е] бѣ създалъ въ дн҃и сиа к҃. лѣтъ, в няже създа Соломонъ",
            "bbox_xywh": [
              167,
              1234,
              919,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
