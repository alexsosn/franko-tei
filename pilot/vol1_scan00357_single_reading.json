                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i357-first-image-20261125"
              }
            ]
          },
          {
            "id": "two-headed-servant-l006",
            "text": "моужа ѡ дву голову. И ѡбыче ж[е] ся житьємъ¹) у Соломона",
            "bbox_xywh": [
              167,
              1339,
              919,
              33
