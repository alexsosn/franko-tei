                "start": 0,
                "end": 61,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "main-line-37",
            "text": "его статї призбирано і опубліковано богато нового матеріялу із уст",
            "bbox_xywh": [
              151,
              1411,
              977,
              29
            ],
            "geometry_estimated": true,
            "language_spans": [
