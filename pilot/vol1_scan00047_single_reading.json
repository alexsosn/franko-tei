        "geometry_estimated": true,
        "lines": [
          {
            "id": "main-line-23",
            "text": "Що торкаєть ся нашої устної словесности, то тут вплив апо-",
            "bbox_xywh": [
              151,
              917,
              977,
              29
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt6-image-only-i47-20261112",
                "start": 0,
                "end": 58,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "main-line-24",
            "text": "кріфічних оповідань був далеко значнїйший і дуже глибокий. До-",
            "bbox_xywh": [
              151,
              952,
              977,
              29
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt6-image-only-i47-20261112",
                "start": 0,
                "end": 62,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "main-line-25",
            "text": "сить буде сказати, що самі тексти тих оповідань доси знаходять ся",
            "bbox_xywh": [
              151,
              987,
              977,
              29
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt6-image-only-i47-20261112",
                "start": 0,
                "end": 65,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "main-line-26",
            "text": "в руках нашого селянства, читають ся письменними а радо слуха-",
            "bbox_xywh": [
              151,
              1022,
              977,
              29
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt6-image-only-i47-20261112",
                "start": 0,
                "end": 62,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "main-line-27",
            "text": "ють ся неписьменними людьми. От тим то й не диво, що з уст",
            "bbox_xywh": [
              151,
              1058,
              977,
              29
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt6-image-only-i47-20261112",
                "start": 0,
                "end": 58,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "main-line-28",
            "text": "українського народа збирачі позаписували доси велику часть тих",
            "bbox_xywh": [
              151,
              1093,
              977,
              29
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt6-image-only-i47-20261112",
                "start": 0,
                "end": 62,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "main-line-29",
            "text": "апокріфічних оповідань, які є в нашій збірцї. Проф. Сумцов у своїй",
            "bbox_xywh": [
              151,
              1128,
              977,
              29
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt6-image-only-i47-20261112",
                "start": 0,
                "end": 66,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "main-line-30",
            "text": "цитованій уже працї звів до купи і старав ся науково пояснити",
            "bbox_xywh": [
              151,
              1164,
              977,
              29
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt6-image-only-i47-20261112",
                "start": 0,
                "end": 61,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "main-line-31",
            "text": "українсько-руські людові апокр. оповіданя, а поперед усего старо-",
            "bbox_xywh": [
              151,
              1199,
              977,
              29
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt6-image-only-i47-20261112",
                "start": 0,
                "end": 65,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "main-line-32",
            "text": "завітні в ось яких ґрупах: 1) сотворенє сьвіта, 2) походженє чортів,",
            "bbox_xywh": [
              151,
              1234,
              977,
              29
            ],
            "geometry_estimated": true,
            "language_spans": [
