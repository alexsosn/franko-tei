                "start": 0,
                "end": 66,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "main-line-38",
            "text": "нашого народа, що назвемо поперед усего прекрасну збірку Іванова",
