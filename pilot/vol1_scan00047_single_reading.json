                "start": 0,
                "end": 68,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "main-line-33",
            "text": "3) сотворенє чоловіка, 4) Адам і Ева. 5) походженє велетнїв, 6) по-",
            "bbox_xywh": [
              151,
              1270,
              977,
              29
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt6-image-only-i47-20261112",
                "start": 0,
                "end": 67,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "main-line-34",
            "text": "топа сьвіта, 7) Самсон, 8) цар Давид, 9) Соломон. Проф. Сумцов не",
            "bbox_xywh": [
              151,
              1305,
              977,
              29
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt6-image-only-i47-20261112",
                "start": 0,
                "end": 65,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "main-line-35",
            "text": "мав під рукою книжних текстів укр. апокріфічних оповідань в такій",
            "bbox_xywh": [
              151,
              1340,
              977,
              29
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt6-image-only-i47-20261112",
                "start": 0,
                "end": 65,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "main-line-36",
            "text": "повнотї, щоби его висновки могли бути повні, та й по написаню",
            "bbox_xywh": [
