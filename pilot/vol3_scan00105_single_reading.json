                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-2-line-05",
            "text": "гл҃я: „ты ли еси грядыи или иного чаем?“ видѣв же Андрей Ха҃",
            "bbox_xywh": [
              113,
              1568,
              981,
              37
