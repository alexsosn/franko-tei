                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-2-line-02",
            "text": "въ ст҃ых ѡц҃ь наших великїи апⷭ҇лъ Іс҃ Ха҃ бѣ ѿ града Виѳсаиды",
            "bbox_xywh": [
              113,
              1454,
              981,
              37
