                "start": 0,
                "end": 62,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-2-line-03",
            "text": "жидовин сїи родом, бяше же рыбарь Тиверїадска моря, сн҃ъ Іѡнин,",
            "bbox_xywh": [
              113,
              1492,
              981,
              37
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00105-20261126",
                "start": 0,
                "end": 63,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-2-line-04",
            "text": "Андреяж [братъ] оучн҃ика Іѡана крⷭ҇тля. сего посла Іѡанъ Ху҃",
            "bbox_xywh": [
              113,
              1530,
              981,
              37
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00105-20261126",
                "start": 0,
