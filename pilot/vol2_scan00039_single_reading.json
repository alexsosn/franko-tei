                "language": "uk",
                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "preface-line-34",
            "text": "в печері, де вродив ся Ісус, вибухло жерело води, що в Римі тої",
            "bbox_xywh": [
