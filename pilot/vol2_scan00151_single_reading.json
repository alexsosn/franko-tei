        "lines": [
          {
            "id": "locust-honey-line-01",
            "text": "Тепер ся каждый пилно еще прислухай, будеш знати, що",
            "language_spans": [
              {
                "text_version": "gpt62-ii-151-image-harmonized-20261127",
