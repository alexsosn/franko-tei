            ],
            "bbox_xywh": [
              61,
              1350,
              970,
              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "locust-honey-line-06",
            "text": "бронъцы, а по словенскій пружіє, а по рускій брунки, а по угор-",
            "language_spans": [
              {
                "text_version": "gpt62-ii-151-image-harmonized-20261127",
                "start": 0,
                "end": 63,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ],
            "bbox_xywh": [
              61,
              1387,
              970,
              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "locust-honey-line-07",
            "text": "скій берекинѣ, и тоє то бж҃іи[м] промыслом уроженыє. А з дру-",
            "language_spans": [
              {
                "text_version": "gpt62-ii-151-image-harmonized-20261127",
                "start": 0,
                "end": 61,
                "language": "orv",
