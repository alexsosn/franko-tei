            ],
            "geometry_estimated": true
          },
          {
            "id": "locust-honey-line-08",
            "text": "гой галузки ишол мѣдъ нашталт [sic !] ольвы зеленой, и то ся",
            "language_spans": [
              {
                "text_version": "gpt62-ii-151-image-harmonized-20261127",
