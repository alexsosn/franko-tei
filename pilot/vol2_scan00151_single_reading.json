              970,
              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "locust-honey-line-05",
            "text": "и то ся называєт языком турецким акрыды, а по грецкій",
            "language_spans": [
              {
                "text_version": "gpt62-ii-151-image-harmonized-20261127",
                "start": 0,
                "end": 53,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
