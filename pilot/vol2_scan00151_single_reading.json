              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "locust-honey-line-03",
            "text": "предивный: бѣлые брунки як свѣтъ, на подобенство горохового",
            "language_spans": [
              {
                "text_version": "gpt62-ii-151-image-harmonized-20261127",
                "start": 0,
                "end": 59,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ],
            "bbox_xywh": [
              61,
              1278,
              970,
              33
            ],
            "geometry_estimated": true
          },
          {
            "id": "locust-honey-line-04",
            "text": "струча, а солодок як цукеръ албо мовячи сахаръ, и барзо сытно,",
            "language_spans": [
              {
                "text_version": "gpt62-ii-151-image-harmonized-20261127",
                "start": 0,
                "end": 62,
