              1455,
              968,
              32
            ],
            "geometry_estimated": true
          },
          {
            "id": "plato-line-03",
            "text": "нѣсть Бг҃ъ, но єсть Бг҃ъ на небесехъ, ємуже снити на землю",
            "language_spans": [
              {
                "text_version": "gpt62-ii-115-image-harmonized-20261126",
                "start": 0,
