            "id": "plato-line-05",
            "text": "рехъ стѣхъ лѣтъ по бж҃ественнѣмъ єго рождествѣ мою кость",
            "language_spans": [
              {
                "text_version": "gpt62-ii-115-image-harmonized-20261126",
