            "geometry_estimated": true
          },
          {
            "id": "plato-line-02",
            "text": "виновенъ, злым же никако же“. Той же Платонъ рече: „Аполонъ",
            "language_spans": [
              {
                "text_version": "gpt62-ii-115-image-harmonized-20261126",
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
