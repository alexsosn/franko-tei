            "id": "note-1-line-02",
            "text": "Никити була довша. В текстї опублїкованім Тихонравовим (op. cit. II, ст. 113)",
            "bbox_xywh": [
              118,
              1164,
              1019,
              27
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 56,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00132-20261127"
              },
              {
                "start": 56,
