                "language": "la",
                "script": "Latn",
                "uncertain": false,
                "text_version": "gpt62-v5s00132-20261127"
              },
              {
                "start": 67,
                "end": 77,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00132-20261127"
              }
            ]
          },
          {
            "id": "note-1-line-03",
            "text": "і в популярній перерібцї в рукописї о. Петровського з кінця XVIII в. промова Ни-",
            "bbox_xywh": [
              118,
              1199,
              1019,
              27
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 80,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-v5s00132-20261127"
              }
            ]
          },
          {
            "id": "note-1-line-04",
            "text": "кити має текст такий самий, як наш.",
            "bbox_xywh": [
              118,
              1233,
              1019,
              27
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
