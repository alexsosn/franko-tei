                "text_version": "gpt62-v5s00121-20261126"
              }
            ]
          },
          {
            "id": "body-9-line-02",
            "text": "зритъ во снѣ Га҃, оутверждающа его своею рꙋкою и лобзающа, таж",
            "bbox_xywh": [
              105,
              1315,
              979,
              31
