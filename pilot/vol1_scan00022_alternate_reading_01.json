                "start": 0,
                "end": 74,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "note-line-20",
            "text": "Христовъ поруганіи и хулами стрѣляютъ“ (Православный Собесѣдникъ 1863, т. II).",
