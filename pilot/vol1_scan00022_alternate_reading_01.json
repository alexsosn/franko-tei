                "language": "uk",
                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "note-line-09",
            "text": "короткого послѣсловія до Дамаскинового твору „О єресехъ“. Впрочім Курбський",
            "bbox_xywh": [
              140,
              1212,
              953,
              26
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-single-20261125-v1s00022",
