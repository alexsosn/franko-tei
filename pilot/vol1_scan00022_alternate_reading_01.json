                "start": 50,
                "end": 64,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false
              },
              {
                "text_version": "gpt62-single-20261125-v1s00022",
                "start": 64,
                "end": 67,
                "language": "zxx",
                "script": "Latn",
                "uncertain": false
              },
              {
                "text_version": "gpt62-single-20261125-v1s00022",
                "start": 67,
                "end": 80,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "note-line-07",
            "text": "клад без сумнїву значно старший, без сьлїдів білорущини, які мають знаходити ся",
            "bbox_xywh": [
              140,
              1154,
              953,
              26
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-single-20261125-v1s00022",
                "start": 0,
                "end": 79,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "note-line-08",
            "text": "в перекладї Курбського, і отсї слова, так як їх висше виписано, знаходять ся на кінцї",
            "bbox_xywh": [
              140,
              1183,
              953,
              26
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-single-20261125-v1s00022",
                "start": 0,
