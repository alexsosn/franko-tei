                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "note-line-12",
            "text": "ся лжесловесникомъ, преобразующимся въ истовые учители, и пишутъ повѣсть со-",
            "bbox_xywh": [
              140,
              1299,
              953,
              26
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-single-20261125-v1s00022",
                "start": 0,
                "end": 76,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "note-line-13",
            "text": "противнѣ евангельскимъ словесемъ, и имена своя скрывше, да не обличени будутъ,",
            "bbox_xywh": [
              140,
              1328,
              953,
              26
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-single-20261125-v1s00022",
                "start": 0,
                "end": 78,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "note-line-14",
            "text": "и подписуютъ ихъ на святыхъ имена, да удобно ихъ писаніе пріймется простыми",
            "bbox_xywh": [
              140,
              1357,
              953,
              26
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-single-20261125-v1s00022",
                "start": 0,
                "end": 75,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "note-line-15",
            "text": "и неучеными. Али не слышалъ еси, какову бѣду отъ таковыхъ въ литовской земли",
            "bbox_xywh": [
              140,
              1386,
              953,
              26
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-single-20261125-v1s00022",
                "start": 0,
                "end": 76,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "note-line-16",
            "text": "церковь Божія пріемлетъ? Апостольскія слова превращаются, развращеніе толкуютъ,",
            "bbox_xywh": [
              140,
              1415,
              953,
              26
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-single-20261125-v1s00022",
                "start": 0,
                "end": 79,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "note-line-17",
            "text": "на святыхъ хулу полагаютъ. И отъ книгъ русскихъ емлющи словеса развращенныя,",
            "bbox_xywh": [
              140,
              1444,
              953,
              26
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-single-20261125-v1s00022",
                "start": 0,
                "end": 76,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "note-line-18",
            "text": "отъ Еремеи попа болгарскаго сложены и иныхъ таковыхъ и на Златоустаго имя",
            "bbox_xywh": [
              140,
              1473,
              953,
              26
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-single-20261125-v1s00022",
                "start": 0,
                "end": 73,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "note-line-19",
            "text": "подписано и на иныхъ святыхъ, яко щиты себѣ носятъ и изъ за нихъ на законъ",
            "bbox_xywh": [
              140,
              1502,
              953,
              26
            ],
            "geometry_estimated": true,
            "language_spans": [
