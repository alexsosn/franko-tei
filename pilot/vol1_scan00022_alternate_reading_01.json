                "start": 0,
                "end": 79,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "note-line-05",
            "text": "писний переклад деяких творів сьв. Івана Дамаскина; рукопис (власність проф. О.",
            "bbox_xywh": [
              140,
              1096,
              953,
              26
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-single-20261125-v1s00022",
                "start": 0,
                "end": 79,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "note-line-06",
            "text": "Левіцького в Станіславові) походить з початку XVII. а може ще з XVI. віку; пере-",
            "bbox_xywh": [
              140,
              1125,
              953,
              26
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-single-20261125-v1s00022",
                "start": 0,
                "end": 46,
                "language": "uk",
