                "end": 79,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false
              }
            ]
          },
          {
            "id": "note-line-11",
            "text": "ність у литовській Руси, пишучи з відси до одного московського монаха: „Противлю",
            "bbox_xywh": [
              140,
              1270,
              953,
              26
            ],
            "geometry_estimated": true,
            "language_spans": [
