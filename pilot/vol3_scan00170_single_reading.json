                "uncertain": false,
                "start": 0,
                "end": 58
              }
            ]
          },
          {
            "id": "commentary-line-02",
            "text": "ловно тим, що крім звісних нам уже лєґенд, черпаних із Псевдо-",
            "bbox_xywh": [
              142,
              1421,
              963,
              35
