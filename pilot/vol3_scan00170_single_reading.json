                "language": "uk",
                "script": "Cyrl",
                "uncertain": false,
                "start": 0,
                "end": 62
              }
            ]
          },
          {
            "id": "commentary-line-03",
            "text": "Прохора (не безпосередно, але через другі руки) подає лєґенду про",
            "bbox_xywh": [
              142,
              1456,
              963,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00170-20261126",
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false,
                "start": 0,
                "end": 65
              }
            ]
          },
          {
            "id": "commentary-line-04",
            "text": "подорож Богородицї з Іваном на Кипр і на Афонську гору, зложену",
            "bbox_xywh": [
              142,
              1490,
              963,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00170-20261126",
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false,
                "start": 0,
                "end": 63
              }
            ]
          },
          {
            "id": "commentary-line-05",
            "text": "на Афонї в XII—XIII в., а також тим, що наш автор нічого не знає",
            "bbox_xywh": [
              142,
              1525,
              963,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
