              }
            ]
          },
          {
            "id": "body-3-line-07",
            "text": "каждого часѹ годинѹ выбиваєтъ, не такѹ, яко тѹ цконъ [sic!],",
            "bbox_xywh": [
              140,
              1102,
              965,
              36
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00170-20261126",
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "start": 0,
                "end": 54
              },
              {
                "text_version": "gpt62-v3-s00170-20261126",
                "language": "la",
                "script": "Latn",
                "uncertain": false,
                "start": 54,
                "end": 58
              },
              {
                "text_version": "gpt62-v3-s00170-20261126",
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "start": 58,
                "end": 60
              }
            ]
          },
          {
            "id": "body-3-line-08",
            "text": "але мл҃твѹ каждой годины до Хр҃та выбиваєтъ, и оупадаетъ и",
            "bbox_xywh": [
              140,
              1138,
              965,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00170-20261126",
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "start": 0,
                "end": 58
              }
            ]
          },
          {
            "id": "body-3-line-09",
            "text": "млит' ся за весь міръ, бо емѹ дана бл҃годать мл҃ити ся за ны,",
            "bbox_xywh": [
              140,
              1173,
              965,
              36
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00170-20261126",
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "start": 0,
                "end": 61
              }
            ]
          },
          {
            "id": "body-3-line-10",
            "text": "есть равенъ агг҃лом на нб҃ѣ. тако и мы, правовѣрныи хрст҃їане,",
            "bbox_xywh": [
              140,
              1209,
              965,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00170-20261126",
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "start": 0,
                "end": 62
              }
            ]
          },
          {
            "id": "body-3-line-11",
            "text": "дн҃сь празднѹючи чт҃ное преставленїе ст҃. Іѡана, просме его, абы",
            "bbox_xywh": [
              140,
              1244,
              965,
              36
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00170-20261126",
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "start": 0,
                "end": 64
              }
            ]
          },
          {
            "id": "body-3-line-12",
            "text": "за нами Хр҃та сп҃сителя оумлилъ, а ны Іс҃ Хс҃ сп҃тел за мл҃твою",
            "bbox_xywh": [
              140,
              1280,
              965,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00170-20261126",
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "start": 0,
                "end": 63
              }
            ]
          },
          {
            "id": "body-3-line-13",
            "text": "ст҃аго Іѡана нба҃ сподобить на вѣки. Аминь.",
            "bbox_xywh": [
              140,
              1315,
              965,
              36
