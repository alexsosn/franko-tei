      {
        "id": "body-3",
        "kind": "body",
        "bbox_xywh": [
          143,
          1167,
          963,
          386
        ],
        "geometry_estimated": true,
        "lines": [
          {
            "id": "body-3-line-01",
            "text": "Таже дошед горы тоя, идѣже разбойничество бяше, ятъ",
            "bbox_xywh": [
              143,
              1167,
              963,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00148-20261126",
                "start": 0,
                "end": 51,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-3-line-02",
            "text": "бы҃ стражем, никакоже ѡвѣща ни жаля си, но гл҃а: „На се есмь",
            "bbox_xywh": [
              143,
              1202,
              963,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00148-20261126",
                "start": 0,
                "end": 60,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-3-line-03",
            "text": "пришелъ, ко старейшине вашемоу ведите мя“. тъ же стояше съ",
            "bbox_xywh": [
              143,
              1237,
              963,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00148-20261126",
                "start": 0,
                "end": 58,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-3-line-04",
            "text": "ѡроужїемъ, яко точїю оузре Іѡана, побѣже. Іѡанъ же забывъ",
            "bbox_xywh": [
              143,
              1272,
              963,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00148-20261126",
                "start": 0,
                "end": 57,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-3-line-05",
            "text": "старость, не въздержа ся оуношю гоняше въпїя и гл҃а: „Что",
            "bbox_xywh": [
              143,
              1307,
              963,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00148-20261126",
                "start": 0,
                "end": 57,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-3-line-06",
            "text": "мене бѣгаеши, чадо, своего Ѡц҃а? почто ми троуд даеши? по-",
            "bbox_xywh": [
              143,
              1342,
              963,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00148-20261126",
                "start": 0,
                "end": 58,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-3-line-07",
            "text": "милоуи мя тоуждаго стар'ца, немощна и оубога! стани, не бой",
            "bbox_xywh": [
              143,
              1377,
              963,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00148-20261126",
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-3-line-08",
            "text": "ся! имаши надежю сп҃нїа. азъ дш҃ю свою за тя положю, якоже",
            "bbox_xywh": [
              143,
              1412,
              963,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00148-20261126",
                "start": 0,
                "end": 58,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-3-line-09",
            "text": "Гъ҃ за ны. не бой ся, чадо, стани! ими вѣроу! Хс҃ посла мя про-",
            "bbox_xywh": [
              143,
              1447,
              963,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00148-20261126",
                "start": 0,
                "end": 63,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-3-line-10",
            "text": "стыню ти несоуща. азъ за тя претерплю смр҃ть. на мнѣ кровь,",
            "bbox_xywh": [
              143,
              1482,
              963,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00148-20261126",
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-3-line-11",
            "text": "юже еси пролїялъ, на моей выи бремя грѣховъ твоих“.",
            "bbox_xywh": [
              143,
              1517,
              963,
              36
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00148-20261126",
                "start": 0,
                "end": 51,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          }
        ]
      },
