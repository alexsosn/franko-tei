            ],
            "geometry_estimated": true
          },
          {
            "id": "sibyl-phrygian-line-06",
            "text": "возвѣститъ и видимо всѣмъ Вышняго явит, злыхъ вознена-",
            "language_spans": [
              {
                "text_version": "gpt62-ii-102-image-harmonized-20261126",
                "start": 0,
