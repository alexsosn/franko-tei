            "geometry_estimated": true
          },
          {
            "id": "sibyl-phrygian-line-05",
            "text": "яко благоволеніе бж҃іе, крѣпость умножит, родъ свой на земли",
            "language_spans": [
              {
                "text_version": "gpt62-ii-102-image-harmonized-20261126",
                "start": 0,
