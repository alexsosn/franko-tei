            ]
          },
          {
            "id": "body-6-line-06",
            "text": "шого міста скриня, до якої нїхто з нас не може приступити, але",
            "bbox_xywh": [
              77,
              1216,
              1014,
              39
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 62,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00086-20261126"
              }
            ]
          },
          {
            "id": "body-6-line-07",
            "text": "видимо що ночи в нїй огняне полумя, і вода з неї тече, і нїхто",
            "bbox_xywh": [
              77,
              1255,
              1014,
              39
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 62,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00086-20261126"
              }
            ]
          },
          {
            "id": "body-6-line-08",
            "text": "не знає, що там у нїй. І коли зможеш отворити її, то й я увірую“.",
            "bbox_xywh": [
              77,
              1294,
              1014,
              39
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 65,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00086-20261126"
              }
            ]
          }
        ]
      },
      {
        "id": "body-7",
        "kind": "body",
        "bbox_xywh": [
