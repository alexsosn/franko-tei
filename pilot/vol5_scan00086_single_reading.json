          1334,
          1014,
          351
        ],
        "geometry_estimated": true,
        "lines": [
          {
            "id": "body-7-line-01",
            "text": "І мовив святий: „Готов я зробити се іменем мойого Христа“.",
            "bbox_xywh": [
              77,
              1334,
              1014,
              39
