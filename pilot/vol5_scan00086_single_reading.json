                "language": "uk",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00086-20261126"
              }
            ]
          },
          {
            "id": "body-7-line-02",
            "text": "І прийшов цар і святий і богато народу з ним на серед города,",
            "bbox_xywh": [
              77,
              1373,
              1014,
              39
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 61,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00086-20261126"
              }
            ]
          },
          {
            "id": "body-7-line-03",
            "text": "і припавши на колїна святий помолив ся мовлячи: „Господи Ісусе",
            "bbox_xywh": [
              77,
              1412,
              1014,
              39
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 62,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00086-20261126"
              }
            ]
          },
          {
            "id": "body-7-line-04",
            "text": "Христе, що зійшов у Ад і відчинив двері смертні і воскресив по-",
            "bbox_xywh": [
              77,
              1451,
              1014,
              39
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 63,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00086-20261126"
              }
            ]
          },
          {
            "id": "body-7-line-05",
            "text": "мерших від віків, вислухай мене смирного і недостойного раба тво-",
            "bbox_xywh": [
              77,
              1490,
              1014,
              39
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 65,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00086-20261126"
              }
            ]
          },
          {
            "id": "body-7-line-06",
            "text": "його, відчини отсю скриню, аби прославило ся імя твоє святе“.",
            "bbox_xywh": [
              77,
              1529,
              1014,
              39
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 61,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00086-20261126"
              }
            ]
          },
          {
            "id": "body-7-line-07",
            "text": "І коли говорив се, нараз зробив ся трус і сїм блискавок і рап-",
            "bbox_xywh": [
              77,
              1568,
              1014,
              39
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 62,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00086-20261126"
              }
            ]
          },
          {
            "id": "body-7-line-08",
            "text": "товно відчинила ся скриня і встали святі отроки, що мучили ся",
            "bbox_xywh": [
              77,
              1607,
              1014,
              39
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 61,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00086-20261126"
              }
            ]
          },
          {
            "id": "body-7-line-09",
            "text": "в Ефесї, і почали цїлувати один одного. Бачучи здїяне чудо, цар",
            "bbox_xywh": [
              77,
              1646,
              1014,
              39
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
