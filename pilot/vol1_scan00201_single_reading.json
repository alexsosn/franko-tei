                "language": "la",
                "script": "Latn",
                "uncertain": false,
                "text_version": "gpt62-i201-first-image-20261125"
              },
              {
                "start": 29,
                "end": 30,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i201-first-image-20261125"
              },
              {
                "start": 30,
                "end": 35,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i201-first-image-20261125"
              },
              {
                "start": 35,
                "end": 62,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i201-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-lament-in-pit-l014",
            "text": "разлученъ бых ѿ лица твоего! кто бы ми дал голубицоу вѣ-",
            "bbox_xywh": [
              183,
              1408,
              944,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 56,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i201-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-lament-in-pit-l015",
            "text": "щающоу бесѣдам, да прелетѣвши възвѣстит старости твоєи",
            "bbox_xywh": [
              183,
              1444,
              944,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 54,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i201-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-lament-in-pit-l016",
            "text": "плач мои! ищезноуша ѡчи ѿ слезъ и въздыханїя. изълмьче",
            "bbox_xywh": [
              183,
              1480,
              944,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
