                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i201-first-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-lament-in-pit-l017",
            "text": "грътан[ь] и нѣс[ть] помагаяи. ѡ земле, земле, възопив'шїя",
            "bbox_xywh": [
              183,
              1516,
              944,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 57,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
