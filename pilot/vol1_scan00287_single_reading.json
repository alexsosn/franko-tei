              }
            ]
          },
          {
            "id": "joseph-opening-l006",
            "text": "и Гк҃ възлюби мя; сии хотѣша мя въ³) злѣ³) убити, но Бж҃ ѡц҃ь",
            "bbox_xywh": [
              130,
              815,
              963,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 61,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i287-contents-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-opening-l007",
            "text": "моихъ съхрани мя. в ровъ мя ввергоша, и Вышнии извѣде",
            "bbox_xywh": [
              130,
              851,
              963,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 53,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i287-contents-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-opening-l008",
            "text": "мя; в работу мя продаше, и Гк҃ всѣх свободи мя; и в полонъ",
            "bbox_xywh": [
              130,
              887,
              963,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 58,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i287-contents-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-opening-l009",
            "text": "влѣзох, и крѣпкая его рука помозе ми. глад[о]мъ ѡжатъ бых,",
            "bbox_xywh": [
              130,
              923,
              963,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 58,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i287-contents-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-opening-l010",
            "text": "и самъ Гк҃ препита мя; в тѣмници бѣх, [и] Сп҃съ⁴) радость ми",
            "bbox_xywh": [
              130,
              959,
              963,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 60,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i287-contents-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-opening-l011",
            "text": "сътвори; един бѣхъ, и Гк҃ утѣши мя; и в болѣзни бѣхъ, [и]",
            "bbox_xywh": [
              130,
              995,
              963,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 57,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i287-contents-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-opening-l012",
            "text": "Гк҃ посѣти мя; въ узѣхъ — и Гк҃ ѡрѣши мя; въ ѡклевѣтании —",
            "bbox_xywh": [
              130,
              1031,
              963,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 58,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i287-contents-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-opening-l013",
            "text": "и Гк҃ избави мя; въ словесех Егуптянинѣ горцѣх — и изять",
            "bbox_xywh": [
              130,
              1067,
              963,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 56,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i287-contents-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-opening-l014",
            "text": "мя; в зависти сущим съ мною работах, и възнесе мя. и тако",
            "bbox_xywh": [
              130,
              1103,
              963,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 57,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i287-contents-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-opening-l015",
            "text": "скопечкыи старшина домъ поручи ми свой, и страсть пріяхъ",
            "bbox_xywh": [
              130,
              1139,
              963,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 56,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i287-contents-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-opening-l016",
            "text": "ѿ жены скверныа⁵), нуд[а]щи мя съгрѣшити с нѣю, но Бж҃",
            "bbox_xywh": [
              130,
              1175,
              963,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 54,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i287-contents-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-opening-l017",
            "text": "Іл҃въ ѡц҃а моего избави мя ѿ пламени горящаго. в тѣмницю",
            "bbox_xywh": [
              130,
              1211,
              963,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 56,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i287-contents-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-opening-l018",
            "text": "всаженъ бых и бьенъ бѣхъ и укоренъ бых, и да мя⁶) въ ще-",
            "bbox_xywh": [
              130,
              1247,
              963,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 56,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i287-contents-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-opening-l019",
            "text": "дроту подтѣмници хранителемъ. не ѡставит бо Гк҃ боящих ся",
            "bbox_xywh": [
              130,
              1283,
              963,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 57,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i287-contents-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-opening-l020",
            "text": "его въ тмѣ ли, въ узахъ или въ печалехъ или въ бѣдахъ. не",
            "bbox_xywh": [
              130,
              1319,
              963,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 57,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i287-contents-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-opening-l021",
            "text": "бо акы чл҃къ стыдит ся Бж҃, не акы сн҃ъ чл҃чь боит ся, ни акы зе-",
            "bbox_xywh": [
              130,
              1355,
              963,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 65,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i287-contents-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-opening-l022",
            "text": "мленыи изнемагаетъ или въ ѡступаетъ⁷). въ всѣх же сих не",
            "bbox_xywh": [
              130,
              1391,
              963,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 56,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i287-contents-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-opening-l023",
            "text": "врѣжаетъ⁸), в различныхъ [sic !] скорбѣхъ утѣшаетъ и присѣщаетъ",
            "bbox_xywh": [
              130,
              1427,
              963,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 25,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i287-contents-image-20261125"
              },
              {
                "start": 25,
                "end": 32,
                "language": "la",
                "script": "Latn",
                "uncertain": false,
