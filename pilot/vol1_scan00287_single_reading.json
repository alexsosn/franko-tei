                "uncertain": true,
                "text_version": "gpt62-i287-contents-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-opening-l025",
            "text": "показа, въ всѣх долготерпѣниихъ⁹) ꙗко велик даръ¹⁰) есть",
            "bbox_xywh": [
              130,
              1499,
              963,
              33
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
