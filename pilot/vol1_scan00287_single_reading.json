                "end": 63,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-i287-contents-image-20261125"
              }
            ]
          },
          {
            "id": "joseph-opening-l024",
            "text": "въ искушении душевныхъ мыслей. въ д҃-ти искушении крѣпка мя",
            "bbox_xywh": [
              130,
              1463,
              963,
              33
