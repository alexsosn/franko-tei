        ],
        "geometry_estimated": true,
        "lines": [
          {
            "id": "levi-opening-l001",
            "text": "Въписаніи словес Левгіинъ, елико заповѣда сн҃мъ своим",
            "bbox_xywh": [
              170,
              982,
              942,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 53,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i255-first-image-20261125"
              }
            ]
          },
          {
            "id": "levi-opening-l002",
            "text": "преж[е] скончанія своего по всему, елико сътворят, елико ж[е]",
            "bbox_xywh": [
              170,
              1018,
              942,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 61,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i255-first-image-20261125"
              }
            ]
          },
          {
            "id": "levi-opening-l003",
            "text": "имъ случить с[я] до дн҃и смр҃тнаго¹) суднаго. здравъ сы еще",
            "bbox_xywh": [
              170,
              1054,
              942,
              35
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i255-first-image-20261125"
              }
            ]
          },
          {
            "id": "levi-opening-l004",
            "text": "призва ꙗ къ собѣ, яви бо ся ему, ꙗко хощет умрет[и]. и егда**)",
            "bbox_xywh": [
              170,
              1091,
              942,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 62,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i255-first-image-20261125"
              }
            ]
          },
          {
            "id": "levi-opening-l005",
            "text": "събраша с[я] к нему, к нимъ ж[е] ѡ жречествѣ видѣніе възвести",
            "bbox_xywh": [
              170,
              1127,
              942,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 61,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i255-first-image-20261125"
              }
            ]
          },
          {
            "id": "levi-opening-l006",
            "text": "и ѡ прозорьствѣ²) преж[е] скончанія своего. „Азъ Левгий в радо-",
            "bbox_xywh": [
              170,
              1163,
              942,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 63,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i255-first-image-20261125"
              }
            ]
          },
          {
            "id": "levi-opening-l007",
            "text": "сти зачахся и рад[и] ся, и бѣ възрастною³) въ дому ѡц҃а мо-",
            "bbox_xywh": [
              170,
              1199,
              942,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 59,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i255-first-image-20261125"
              }
            ]
          },
          {
            "id": "levi-opening-l008",
            "text": "его. и егда приидох съ ѡц҃ьм в Сикимъ, бѣхъ же юнъ ꙗко",
            "bbox_xywh": [
              170,
              1235,
              942,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 54,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i255-first-image-20261125"
              }
            ]
          },
          {
            "id": "levi-opening-l009",
            "text": "к҃. лѣт, егда сътворих съ Семеѡномъ ѡмщеніе сестры нашея",
            "bbox_xywh": [
              170,
              1271,
              942,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 56,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i255-first-image-20261125"
              }
            ]
          },
          {
            "id": "levi-opening-l010",
            "text": "Дины. но егда пасахъ в Леломавле, дх҃ъ разума бж҃ія прид[е] на",
            "bbox_xywh": [
              170,
              1307,
              942,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 62,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i255-first-image-20261125"
              }
            ]
          },
          {
            "id": "levi-opening-l011",
            "text": "мя, и вся видѣхъ чл҃вкы ѡставльше путь свои, ꙗко стену възгра-",
            "bbox_xywh": [
              170,
              1343,
              942,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 62,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i255-first-image-20261125"
              }
            ]
          },
          {
            "id": "levi-opening-l012",
            "text": "дилъ⁴) бяше Неправда, и⁵) на сн҃ѣхъ безаконіе пребывашет. и печа-",
            "bbox_xywh": [
              170,
              1379,
              942,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 65,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i255-first-image-20261125"
              }
            ]
          },
          {
            "id": "levi-opening-l013",
            "text": "ленъ бѣхъ ѿ роде чл҃честемь и помолихъ Гви҃, да сп҃сется. и тогда",
            "bbox_xywh": [
              170,
              1415,
              942,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 65,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
                "text_version": "gpt62-i255-first-image-20261125"
              }
            ]
          },
          {
            "id": "levi-opening-l014",
            "text": "нападе на мя сонъ и видѣх гору высоку, та гора Щит именемь",
            "bbox_xywh": [
              170,
              1451,
              942,
              34
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "start": 0,
                "end": 58,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": false,
