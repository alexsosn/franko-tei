            "id": "body-2-line-06",
            "text": "възнесенїа Гня҃ пришолъ въ Еѳес и тамо проповѣдалъ ег҃лїе Хво҃",
            "bbox_xywh": [
              125,
              1175,
              983,
              38
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00171-20261126",
                "start": 0,
                "end": 62,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-2-line-07",
            "text": "Жидомъ и Ел'линомъ, оучаше невѣровавшихъ достаточне ѡ",
            "bbox_xywh": [
              125,
              1213,
              983,
              37
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00171-20261126",
                "start": 0,
                "end": 53,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-2-line-08",
            "text": "любви, котрая ко Бг҃ѹ и къ ближнимъ, и поганы приводилъ ко",
            "bbox_xywh": [
              125,
              1250,
              983,
              38
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00171-20261126",
                "start": 0,
                "end": 58,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-2-line-09",
            "text": "вѣрѣ Хвои҃ и грѣшныхъ къ покаянїю. И геретиковъ и Епикѹровъ,",
            "bbox_xywh": [
              125,
              1288,
              983,
              37
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00171-20261126",
                "start": 0,
                "end": 60,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-2-line-10",
            "text": "которыи въскрн҃їа не повѣдают быти ани дш҃и въ чл҃цѣ, но кровь",
            "bbox_xywh": [
              125,
              1325,
              983,
              37
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00171-20261126",
                "start": 0,
                "end": 62,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-2-line-11",
            "text": "за дш҃ѹ почитѹютъ, и за ин'шихъ геретиковъ Евикѣтовъ и Ирї-",
            "bbox_xywh": [
              125,
              1362,
              983,
              38
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00171-20261126",
                "start": 0,
                "end": 59,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-2-line-12",
            "text": "роновъ, который блюзнили на Бж҃ество Га҃ нашего Іс҃ Ха҃, пред-",
            "bbox_xywh": [
              125,
              1400,
              983,
              37
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00171-20261126",
                "start": 0,
                "end": 62,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-2-line-13",
            "text": "вѣчности емѹ не признавали, тым Іѡанъ ст҃ый препираше и оука-",
            "bbox_xywh": [
              125,
              1437,
              983,
              38
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00171-20261126",
                "start": 0,
                "end": 61,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-2-line-14",
            "text": "заше и сѹдомъ Бж҃їим' прѣташе имъ, абы престали ѡ таковаго",
            "bbox_xywh": [
              125,
              1475,
              983,
              37
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00171-20261126",
                "start": 0,
                "end": 58,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-2-line-15",
            "text": "блюзнѣрства, Антихристами тых называетъ. И за горячею ми-",
            "bbox_xywh": [
              125,
              1512,
              983,
              37
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00171-20261126",
                "start": 0,
                "end": 57,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-2-line-16",
            "text": "лостїю залатривши ся по Гд҃ѣ Бзѣ҃ своемъ, и всяды балвано-",
            "bbox_xywh": [
              125,
              1549,
              983,
              38
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00171-20261126",
                "start": 0,
                "end": 58,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-2-line-17",
            "text": "хвалство выкореновалъ и поган'скыи божницѣ розбѹровалъ. и въ",
            "bbox_xywh": [
              125,
              1587,
              983,
              37
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-v3-s00171-20261126",
                "start": 0,
                "end": 60,
                "language": "orv",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "body-2-line-18",
            "text": "самом Ефесѣ мѣстѣ розбѹрилъ божницѹ названѹю Амазомъ",
            "bbox_xywh": [
              125,
              1624,
              983,
              38
            ],
            "geometry_estimated": true,
            "language_spans": [
