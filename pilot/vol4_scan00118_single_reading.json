                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-35",
            "text": "сусѣд под окномъ, все єсте на волхвах и вся дѣла дїаволская",
            "bbox_xywh": [
