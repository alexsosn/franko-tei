                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-30",
            "text": "горе вамъ, ѡсквернили єсте землю и закон бж҃їй и цр҃ковъ ст҃ую.",
            "bbox_xywh": [
              118,
              1203,
