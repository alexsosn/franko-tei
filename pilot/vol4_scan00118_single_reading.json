                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-33",
            "text": "дал по правилу церковном, а ви церковъ ст҃ую ѡставили, котрая",
            "bbox_xywh": [
              118,
              1311,
              971,
