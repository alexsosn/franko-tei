                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-38",
            "text": "живих вас не пожрет? якїй ѡвѣтъ дасте на оном свѣтѣ пред",
            "bbox_xywh": [
