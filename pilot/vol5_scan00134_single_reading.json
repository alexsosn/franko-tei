                "language": "orv",
                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00134-20261127"
              }
            ]
          },
          {
            "id": "body-6-line-08",
            "text": "ст҃че бж҃їй, и скажꙋ ти. Ꙗко же ты тщиши ся ѿ Ба҃ вѣнец при-",
            "bbox_xywh": [
              103,
              1660,
