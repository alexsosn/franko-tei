                "script": "Cyrl",
                "uncertain": true,
                "text_version": "gpt62-v5s00134-20261127"
              }
            ]
          },
          {
            "id": "body-6-line-07",
            "text": "ти имя и кто тя посла къ мнѣ?“ И рече дїавол: „Попꙋсти ми,",
            "bbox_xywh": [
              103,
              1620,
              1019,
