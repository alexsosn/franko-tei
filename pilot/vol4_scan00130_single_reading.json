                "end": 55,
                "language": "cu",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-35",
            "text": "мя Господи, егда прїйдеши въ царствїє Твое!“ Якъ имъ отпу-",
            "bbox_xywh": [
              130,
              1456,
              965,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
