                "start": 43,
                "end": 58,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-36",
            "text": "стилъ Господь Богъ грѣхи и даровалъ имъ животъ вѣчный,",
            "bbox_xywh": [
              130,
              1494,
              965,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-130-image-20261126",
                "start": 0,
                "end": 54,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-37",
            "text": "такъ само сдѣлаетъ и вамъ, єсли житьє ваше исправите. — Кто",
            "bbox_xywh": [
              130,
              1531,
              965,
              32
            ],
            "geometry_estimated": true,
            "language_spans": [
              {
                "text_version": "gpt62-iv-130-image-20261126",
                "start": 0,
                "end": 59,
                "language": "uk",
                "script": "Cyrl",
                "uncertain": true
              }
            ]
          },
          {
            "id": "epistle-line-38",
            "text": "той Листъ Божїй при собѣ мати и ведля него жити буде, той",
            "bbox_xywh": [
              130,
              1569,
              965,
              32
